  {%- when 'barber-pack-2-0' -%}
    {%- assign u = 'doos|Tondeuse en foil shaver;kam|Opzetkammen erbij' -%}
  {%- when 'barber-pack-3-0' -%}
    {%- assign u = 'doos|5 apparaten in één set;regelaars|Knippen, scheren, detail;kam|Opzetkammen erbij' -%}
  {%- when 'barber-bro-1-0' -%}
    {%- assign u = 'doos|Tondeuse en precisietrimmer;regelaars|Fades en contouren' -%}
  {%- when 'barber-bro-2-0' -%}
    {%- assign u = 'doos|Tondeuse en foil shaver;regelaars|Fades en glad afwerken' -%}
  {%- when 'barber-bro-3-0' -%}
    {%- assign u = 'doos|3 apparaten in één set;regelaars|Knippen, scheren, detail' -%}
  {%- when 'skull-shaver-deluxe-extra-magnetische-scheerkop' -%}
    {%- assign u = 'trimmer|7D-scheerkop;mes|Extra scheerkop erbij;motor|7.000 toeren' -%}
  {%- when 'skull-deal-2-0' -%}
    {%- assign u = 'trimmer|Flexibele scheerkoppen;mes|Extra scheerkop erbij;tas|Luxe toilettas' -%}
  {%- when 'skull-deal-3-0' -%}
    {%- assign u = 'trimmer|7D-scheerkop;mes|Extra scheerkop erbij;tas|Travelbag erbij' -%}

  {%- comment -%} Onderdelen en tassen {%- endcomment -%}
  {%- when 'vervanging-bodygroomer-mes' -%}
    {%- assign u = 'mes|Keramisch vervangmes;doos|Voor Groom Guard en PRO' -%}
  {%- when 'trio-pack-groom-guard' -%}
    {%- assign u = 'doos|3 vervangmessen;mes|Voor Groom Guard en PRO' -%}
  {%- when 'trio-pack' -%}
    {%- assign u = 'doos|3 vervangmessen;mes|Voor de Flex Guard' -%}
  {%- when 'flex-guard-blade-vervanging' -%}
    {%- assign u = 'mes|Keramisch vervangmes;doos|Voor de Flex Guard' -%}
  {%- when 'foil-shaver-groom-guard' -%}
    {%- assign u = 'mes|Foil shaver opzetstuk;doos|Voor Groom Guard en PRO' -%}
  {%- when 'wellshave-scheerkop-7d-vervanging' -%}
    {%- assign u = 'mes|7D-vervangkop;doos|Voor de Head Shaver Deluxe' -%}
  {%- when 'elite-scheerkop' -%}
    {%- assign u = 'mes|Vervangkop;doos|Voor de Gentleman Shaver' -%}
  {%- when 'vervanging-neustrimmer-opzetstuk' -%}
