  {%- when 'wellshave-5-in-1-scheerapparaat-mannen-deluxe' -%}
    {%- assign u = 'trimmer|7D-scheerkop;motor|7.000 toeren;accu|Tot 90 min gebruik' -%}

  {%- comment -%} Hoofd en tondeuses {%- endcomment -%}
  {%- when 'wellshave-tondeuse-mannen-deluxe' -%}
