  {%- when 'toiletry-bag' or 'toilettas-free' -%}
    {%- assign u = 'tas|Twee vakken, dubbele rits;doos|Waterafstotend' -%}
  {%- when 'travelbag' -%}
    {%- assign u = 'tas|Soft travelbag;doos|Voor onderweg' -%}
  {%- when 'wellshave-hard-case' -%}
    {%- assign u = 'tas|Harde reiscase;doos|Beschermt je apparaat' -%}
  {%- when 'wellshave-baardbar' -%}
    {%- assign u = 'doos|Vangt baardhaar op;regelaars|Voor de wastafel' -%}
