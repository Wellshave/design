{%- comment -%} Een handmatige regel in de sectie wint van de lijst hierboven. {%- endcomment -%}
{%- if eigen != blank -%}
  {%- assign regels = eigen | newline_to_br | split: '<br />' -%}
  {%- for r in regels -%}
    {%- assign paar = r | strip | split: '=' -%}
    {%- if paar.size == 2 -%}
      {%- assign wie = paar[0] | strip -%}
      {%- if wie == p.handle -%}
        {%- assign u = paar[1] | strip -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%}
  Terugval: geen curatie en geen eigen regel. Dan liever niets verzinnen —
  we tonen het aantal onderdelen als dat bekend is, anders helemaal niets.
{%- endcomment -%}
{%- if u == blank and doos > 0 -%}
  {%- capture u -%}doos|{{ doos }} onderdelen in de doos{%- endcapture -%}
{%- endif -%}

{%- if u != blank -%}
  {%- assign lijst = u | split: ';' -%}
  {%- assign grens = max | default: 3 -%}
  <ul class="wsk-usp">
    {%- for item in lijst limit: grens -%}
      {%- assign d = item | strip | split: '|' -%}
      {%- if d.size == 2 -%}
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#wsr-{{ d[0] | strip }}"/></svg><span>{{ d[1] | strip }}</span></li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
