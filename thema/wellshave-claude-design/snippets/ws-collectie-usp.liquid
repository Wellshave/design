  {%- when 'neustrimmer-3in1-platinum' -%}
    {%- assign u = 'regelaars|3-in-1 met scheerkop;motor|7.000 toeren;accu|USB Fast Charge' -%}
  {%- when 'neustrimmer-4in1-ultra' -%}
    {%- assign u = 'regelaars|4-in-1, ook baard;motor|7.000 toeren;accu|USB Fast Charge' -%}

  {%- comment -%} Safety razors {%- endcomment -%}
  {%- when 'wellshave-safety-razor-black' or 'wellshave-safety-razor-gold' or 'wellshave-safety-razor-matt-grey' or 'wellshave-safety-razor-rose' or 'wellshave-safety-razor-silver' -%}
    {%- assign u = 'mes|20 Japanse mesjes erbij;trimmer|Volledig roestvrij staal;regelaars|Past op standaard mesjes' -%}
  {%- when 'wellshave-safety-razor-blades' -%}
    {%- assign u = 'mes|Double edge-mesjes;doos|Navulling' -%}

  {%- comment -%} Sets {%- endcomment -%}
  {%- when 'wellshave-shave-package-2-0' -%}
    {%- assign u = 'doos|Bodygroomer en neustrimmer;mes|SkinSafe trimbladen;druppel|IPX7 waterdicht' -%}
  {%- when 'wellshave-shave-package-3-0' -%}
