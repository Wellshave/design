{% comment %}
  Wellshave — collectiepagina, blok 1: kop, keuzehulp en zonebalk.
  Ontwerp: de vijf collectiepagina-artifacts (alles, lichaam, gezicht, hoofd, neus).
  Prijs, vanprijs, voorraad en link in het matchpaneel komen uit het gekozen product.
  De beslistabel gaat als JSON naar ws-collectie.js, dat blok 2 laat meebewegen.
{% endcomment %}

{{ 'ws-collectie.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ws-collectie.js' | asset_url }}" defer></script>

{%- assign nl = '<br />' -%}

<div class="wsc">
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <symbol id="wsc-vink" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="wsc-pijl" viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="wsc-retour" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.4-5.7M20 4v4h-4" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="wsc-schild" viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6z" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="wsc-truck" viewBox="0 0 24 24"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7" cy="18" r="1.6" fill="none" stroke="currentColor" stroke-width="2.1"/><circle cx="17" cy="18" r="1.6" fill="none" stroke="currentColor" stroke-width="2.1"/></symbol>
</svg>

<section class="kop">
  {%- if section.settings.monogram_letter != blank -%}
    <span class="kop-merk" aria-hidden="true">{{ section.settings.monogram_letter }}</span>
  {%- endif -%}
  {%- assign heeft_hulp = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'vraag' or block.type == 'match' -%}{%- assign heeft_hulp = true -%}{%- endif -%}
  {%- endfor -%}
  <div class="rail kop-grid{% unless heeft_hulp %} solo{% endunless %}">

    <div class="kop-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow on-dark">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="duo on-dark klein">{{ section.settings.kop_1 }}<span class="b">{{ section.settings.kop_2 }}</span></h1>
      {%- if section.settings.lede != blank -%}
        <p class="lead on-dark kort">{{ section.settings.lede }}</p>
      {%- endif -%}

      {%- if section.settings.foto != blank -%}
        <figure class="kop-foto">
          {{ section.settings.foto | image_url: width: 1400 | image_tag: alt: section.settings.foto_alt, loading: 'eager' }}
        </figure>
      {%- endif -%}

      {%- if section.settings.score != blank or section.settings.quote != blank -%}
        <div class="proefkaart">
          {%- if section.settings.score != blank -%}
            <div class="pk-score">
              {%- assign heel = section.settings.sterren | at_most: 5 -%}
              {%- assign halve_index = heel | plus: 1 -%}
              <div class="sterrenrij" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {%- if i <= heel -%}<i><span></span></i>
                  {%- elsif section.settings.halve_ster and i == halve_index -%}<i class="half"><span></span></i>
                  {%- else -%}<i class="leeg"><span></span></i>{%- endif -%}
                {%- endfor -%}
              </div>
              <b>{{ section.settings.score }}<em>{{ section.settings.score_bron }}</em></b>
            </div>
          {%- endif -%}
          {%- if section.settings.quote != blank -%}
            <div class="pk-quote">
              <span class="pk-vink"><svg viewBox="0 0 24 24"><use href="#wsc-vink"/></svg></span>
              <div>
                <p>&ldquo;{{ section.settings.quote }}&rdquo;</p>
                <span>{{ section.settings.quote_bron }}</span>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="gerustrij">
        {%- if section.settings.gerust_1 != blank -%}
          <div><svg viewBox="0 0 24 24"><use href="#wsc-retour"/></svg>{{ section.settings.gerust_1 }}</div>
        {%- endif -%}
        {%- if section.settings.gerust_2 != blank -%}
          <div><svg viewBox="0 0 24 24"><use href="#wsc-schild"/></svg>{{ section.settings.gerust_2 }}</div>
        {%- endif -%}
        {%- if section.settings.gerust_3 != blank -%}
          <div><svg viewBox="0 0 24 24"><use href="#wsc-truck"/></svg>{{ section.settings.gerust_3 }}</div>
        {%- endif -%}
      </div>
    </div>

    {%- if heeft_hulp -%}
    <div class="kiescard">
      <div class="kaartkop">
        <p class="eyebrow">{{ section.settings.kaartkop }}</p>
        <span>{{ section.settings.kaartsub }}</span>
      </div>
      {%- if section.settings.kaartvraag != blank -%}<h2>{{ section.settings.kaartvraag }}</h2>{%- endif -%}

      <div class="stappen-lijst">
        {%- assign stap = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'vraag' -%}
            {%- assign stap = stap | plus: 1 -%}
            <div class="vraagrij" {{ block.shopify_attributes }}>
              <span class="stapbol">{{ stap | prepend: '0' | slice: -2, 2 }}</span>
              <p>{{ block.settings.vraag }}</p>
              <div class="keuzes" data-groep="{{ block.settings.groep | handle }}">
                {%- assign regels = block.settings.opties | newline_to_br | strip_newlines | split: nl -%}
                {%- for regel in regels -%}
                  {%- assign d = regel | split: '|' -%}
                  {%- if d.size >= 2 -%}
                    {%- assign waarde = d[0] | strip -%}
                    <button type="button" class="keuze" data-v="{{ waarde }}"
                      {% if waarde == block.settings.start %}aria-pressed="true"{% endif %}>{{ d[1] | strip }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'match' -%}
          {%- assign p = block.settings.product -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          <div class="matchpaneel" data-id="{{ block.settings.id | handle }}" {{ block.shopify_attributes }}>
            <div class="mp-kop">
              <b>{{ section.settings.match_label | default: 'Jouw match' }}</b>
              {%- if block.settings.badge != blank -%}<span class="mp-badge">{{ block.settings.badge }}</span>{%- endif -%}
            </div>
            <div class="mp-body">
              {%- if block.settings.foto != blank -%}
                {{ block.settings.foto | image_url: width: 500 | image_tag: alt: p.title }}
              {%- elsif p.featured_image -%}
                {{ p.featured_image | image_url: width: 500 | image_tag: alt: p.title }}
              {%- endif -%}
              <div class="mp-info">
                <h3>{{ block.settings.naam | default: p.title }}</h3>
                <p>{{ block.settings.zin }}</p>
                <p class="mp-waarom">{{ section.settings.waarom_label | default: 'Waarom deze match' }}</p>
                <div class="mp-chips">
                  {%- for n in (1..3) -%}
                    {%- assign sleutel = 'reden_' | append: n -%}
                    {%- assign reden = block.settings[sleutel] -%}
                    {%- if reden != blank -%}
                      <span><svg viewBox="0 0 24 24"><use href="#wsc-vink"/></svg>{{ reden }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
              <div class="mp-koop">
                <span class="mp-prijs">{{ v.price | money }}
                  {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
                </span>
                <a class="mp-knop" href="{{ p.url | default: '#' }}">{{ section.settings.match_cta | default: 'Bekijk jouw match' }}
                  <i><svg viewBox="0 0 24 24"><use href="#wsc-pijl"/></svg></i></a>
                <span class="mp-voorraad">
                  {%- if p.available -%}{{ section.settings.voorraad_wel | default: 'Op voorraad · morgen in huis' }}
                  {%- else -%}{{ section.settings.voorraad_niet | default: 'Tijdelijk uitverkocht' }}{%- endif -%}
                </span>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}

  </div>
</section>

{%- assign heeft_zones = false -%}
{%- for block in section.blocks -%}{%- if block.type == 'zone' -%}{%- assign heeft_zones = true -%}{%- endif -%}{%- endfor -%}
{%- if heeft_zones -%}
  <section class="zonebalk"><div class="rail">
    {%- if section.settings.kruimel != blank -%}
      <p class="kruimel"><a href="{{ routes.root_url }}">Home</a> <span>/</span> <b>{{ section.settings.kruimel }}</b></p>
    {%- endif -%}
    <div class="zones">
      {%- for block in section.blocks -%}
        {%- if block.type == 'zone' -%}
          {%- if block.settings.url != blank and block.settings.huidig != true -%}
            <a class="zone" href="{{ block.settings.url }}" data-zone="{{ block.settings.naam | escape }}"
               data-app="{{ block.settings.aantal }}" {{ block.shopify_attributes }}>{{ block.settings.naam }}
               <span>{{ block.settings.aantal }}</span></a>
          {%- else -%}
            <button type="button" class="zone" {% if block.settings.huidig %}aria-current="true"{% endif %}
               data-zone="{{ block.settings.naam | escape }}" data-app="{{ block.settings.aantal }}"
               {{ block.shopify_attributes }}>{{ block.settings.naam }} <span>{{ block.settings.aantal }}</span></button>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.zonemelding != blank -%}
      <p class="zonemelding">Je bekijkt <b class="zn">{{ section.settings.kruimel }}</b> &mdash;
        <b class="za">{{ section.settings.zone_aantal }}</b> {{ section.settings.zonemelding }}</p>
    {%- endif -%}
  </div></section>
{%- endif -%}

{%- capture keuze_json -%}
{%- assign rijen_uit = '' -%}
{%- assign tabelregels = section.settings.tabel | newline_to_br | strip_newlines | split: nl -%}
{%- for regel in tabelregels -%}
  {%- assign delen = regel | split: '>' -%}
  {%- if delen.size == 2 -%}
    {%- assign paren_uit = '' -%}
    {%- assign paren = delen[0] | split: ',' -%}
    {%- for paar in paren -%}
      {%- assign kv = paar | split: '=' -%}
      {%- if kv.size == 2 -%}
        {%- capture stuk -%}"{{ kv[0] | strip }}":"{{ kv[1] | strip }}"{%- endcapture -%}
        {%- assign paren_uit = paren_uit | append: stuk | append: '|~|' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- assign paren_json = paren_uit | split: '|~|' | join: ',' -%}
    {%- capture rij -%}{"w":{ {{- paren_json -}} },"id":"{{ delen[1] | strip | handle }}"}{%- endcapture -%}
    {%- assign rijen_uit = rijen_uit | append: rij | append: '|~|' -%}
  {%- endif -%}
{%- endfor -%}
{%- assign tabel_json = rijen_uit | split: '|~|' | join: ',' -%}

{%- assign groepen_uit = '' -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'vraag' -%}
    {%- assign woorden_uit = '' -%}
    {%- assign regels = block.settings.opties | newline_to_br | strip_newlines | split: nl -%}
    {%- for regel in regels -%}
      {%- assign d = regel | split: '|' -%}
      {%- if d.size >= 2 -%}
        {%- if d.size >= 3 -%}{%- assign woord = d[2] | strip -%}
        {%- else -%}{%- assign woord = d[1] | strip | downcase -%}{%- endif -%}
        {%- capture stuk -%}"{{ d[0] | strip }}":{{ woord | json }}{%- endcapture -%}
        {%- assign woorden_uit = woorden_uit | append: stuk | append: '|~|' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- capture g -%}"{{ block.settings.groep | handle }}":{ {{- woorden_uit | split: '|~|' | join: ',' -}} }{%- endcapture -%}
    {%- assign groepen_uit = groepen_uit | append: g | append: '|~|' -%}
  {%- endif -%}
{%- endfor -%}
{"tabel":[{{ tabel_json }}],"woord":{ {{- groepen_uit | split: '|~|' | join: ',' -}} },"standaard":"{{ section.settings.standaard | handle }}"}
{%- endcapture -%}
<script type="application/json" id="ws-collectie-keuze">{{ keuze_json | strip }}</script>
</div>

{% schema %}
{
  "name": "WS · Collectie kop",
  "tag": "section",
  "class": "ws-collectie-kop",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Linkerkolom" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Zone · 4 apparaten" },
    { "type": "text", "id": "kop_1", "label": "Kop, eerste regel", "default": "Glad, kort of strak." },
    { "type": "text", "id": "kop_2", "label": "Kop, tweede regel (goud)", "default": "Drie klussen, drie apparaten." },
    { "type": "textarea", "id": "lede", "label": "Inleiding", "info": "Eén tot twee zinnen." },
    { "type": "image_picker", "id": "foto", "label": "Foto van het apparaat in gebruik", "info": "Staat als plaat in de kolom, verhouding 16:8. Geen volle achtergrondband." },
    { "type": "text", "id": "foto_alt", "label": "Alttekst bij de foto" },
    { "type": "text", "id": "monogram_letter", "label": "Monogram linksboven", "default": "S" },
    { "type": "header", "content": "Bewijskaart" },
    { "type": "text", "id": "score", "label": "Score", "info": "Bijvoorbeeld 4,8/5. Laat leeg om de kaart te verbergen.", "default": "4,8/5" },
    { "type": "range", "id": "sterren", "label": "Volle sterren", "min": 0, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "halve_ster", "label": "Halve ster erachter", "default": true },
    { "type": "text", "id": "score_bron", "label": "Waar de score over gaat", "info": "Benoem het altijd. Tel scores van verwante producten niet bij elkaar op: Loox deelt beoordelingen tussen gegroepeerde producten." },
    { "type": "textarea", "id": "quote", "label": "Citaat", "info": "Letterlijk uit een echte beoordeling. Verzin er nooit een." },
    { "type": "text", "id": "quote_bron", "label": "Bron bij het citaat", "default": "Naam · geverifieerde koper · Product" },
    { "type": "header", "content": "Geruststellers" },
    { "type": "text", "id": "gerust_1", "label": "Eerste", "default": "100 dagen proberen" },
    { "type": "text", "id": "gerust_2", "label": "Tweede", "default": "2 jaar garantie" },
    { "type": "text", "id": "gerust_3", "label": "Derde", "default": "Morgen in huis" },
    { "type": "header", "content": "Keuzehulp" },
    { "type": "text", "id": "kaartkop", "label": "Bovenregel", "default": "Jouw apparaat in 30 seconden" },
    { "type": "text", "id": "kaartsub", "label": "Regel rechtsboven", "default": "2 keuzes · direct een match" },
    { "type": "text", "id": "kaartvraag", "label": "Vraag boven de stappen", "default": "Wat ga je precies doen?" },
    { "type": "textarea", "id": "tabel", "label": "Beslistabel", "info": "Eén regel per uitkomst, van specifiek naar algemeen. Vorm: klus=kaal, set=los > head-shaver. De eerste regel die past wint. Zorg dat elk matchpaneel precies één combinatie wint." },
    { "type": "text", "id": "standaard", "label": "Standaarduitkomst", "info": "Het id van het matchpaneel dat toont als geen regel past." },
    { "type": "text", "id": "match_label", "label": "Label boven het paneel", "default": "Jouw match" },
    { "type": "text", "id": "waarom_label", "label": "Kopje boven de redenen", "default": "Waarom deze match" },
    { "type": "text", "id": "match_cta", "label": "Knoptekst", "default": "Bekijk jouw match" },
    { "type": "text", "id": "voorraad_wel", "label": "Voorraadregel · op voorraad", "default": "Op voorraad · morgen in huis" },
    { "type": "text", "id": "voorraad_niet", "label": "Voorraadregel · uitverkocht", "default": "Tijdelijk uitverkocht" },
    { "type": "header", "content": "Zonebalk" },
    { "type": "text", "id": "kruimel", "label": "Naam van deze zone", "default": "Hoofd" },
    { "type": "text", "id": "zone_aantal", "label": "Aantal apparaten in deze zone", "default": "4" },
    { "type": "text", "id": "zonemelding", "label": "Regel achter het aantal", "default": "apparaten, plus de sets en de onderdelen die je later vervangt." },
    { "type": "header", "content": "Indent settings" },
    { "type": "range", "id": "desk_indent_top", "label": "Indent top (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "desk_indent_bottom", "label": "Indent bottom (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mob_indent_top", "label": "Indent top (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "mob_indent_bottom", "label": "Indent bottom (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "vraag",
      "name": "Vraag",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "groep", "label": "Sleutel", "info": "Kort en zonder spaties, bijvoorbeeld klus. Gebruik deze sleutel ook in de beslistabel." },
        { "type": "text", "id": "vraag", "label": "Vraag", "default": "Wat is de klus?" },
        { "type": "textarea", "id": "opties", "label": "Antwoorden", "info": "Eén per regel: waarde|Knoptekst|woord voor de filterregel. Het derde deel mag weg." },
        { "type": "text", "id": "start", "label": "Standaard aangevinkt", "info": "De waarde, niet de knoptekst." }
      ]
    },
    {
      "type": "match",
      "name": "Matchpaneel",
      "settings": [
        { "type": "text", "id": "id", "label": "Id", "info": "Verwijst naar de rechterkant van de beslistabel én naar de kaart in het raster." },
        { "type": "product", "id": "product", "label": "Product", "info": "Prijs, vanprijs, voorraad en link komen hieruit." },
        { "type": "text", "id": "naam", "label": "Naam", "info": "Leeg = de producttitel." },
        { "type": "image_picker", "id": "foto", "label": "Foto", "info": "Leeg = de hoofdafbeelding. Gebruik een vrijstaande packshot." },
        { "type": "text", "id": "badge", "label": "Lintje", "info": "Iets dat waar is: meest gekozen, laagste prijs, nieuw." },
        { "type": "textarea", "id": "zin", "label": "Eén zin" },
        { "type": "text", "id": "reden_1", "label": "Reden 1" },
        { "type": "text", "id": "reden_2", "label": "Reden 2" },
        { "type": "text", "id": "reden_3", "label": "Reden 3" }
      ]
    },
    {
      "type": "zone",
      "name": "Zone in de balk",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "naam", "label": "Naam" },
        { "type": "text", "id": "aantal", "label": "Aantal" },
        { "type": "url", "id": "url", "label": "Link naar de zone" },
        { "type": "checkbox", "id": "huidig", "label": "Dit is de zone die je nu bekijkt", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "WS · Collectie kop" }]
}
{% endschema %}
