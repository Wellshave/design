        "default": "voltooid"
      },
      {
        "type": "text",
        "id": "af_kop",
        "label": "Kop als alles beantwoord is",
        "default": "Jouw match staat klaar."
      },
      {
        "type": "text",
        "id": "af_sub",
        "label": "Regel als alles beantwoord is",
        "default": "Pas een keuze aan of bekijk direct je advies."
      },
      {
        "type": "text",
        "id": "opnieuw",
        "label": "Link om opnieuw te beginnen",
        "default": "Opnieuw beginnen"
      },
      {
        "type": "text",
        "id": "wijzig_label",
        "label": "Voorleestekst van het potlood",
        "default": "Wijzig dit antwoord"
      },
