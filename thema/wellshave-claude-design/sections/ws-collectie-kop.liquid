          {
            "type": "text",
            "id": "reden_1",
            "label": "Reden 1"
          },
          {
            "type": "text",
            "id": "reden_2",
            "label": "Reden 2"
          },
          {
            "type": "text",
            "id": "reden_3",
            "label": "Reden 3"
