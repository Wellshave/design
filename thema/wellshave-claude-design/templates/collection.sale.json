          "type": "vraag",
          "settings": {
            "vraag": "Waar staat de korting die ik krijg?",
            "antwoord": "<p>Op elke kaart, naast de prijs: het percentage en de oude prijs doorgestreept. Het percentage rekent de winkel zelf uit vanaf de vanprijs, dus wat je ziet is wat er daadwerkelijk af gaat.</p>"
          }
        },
        "vraag_4": {
          "type": "vraag",
          "settings": {
            "vraag": "Kan ik een afgeprijsd apparaat terugsturen?",
