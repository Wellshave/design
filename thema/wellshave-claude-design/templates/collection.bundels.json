          }
        },
        "vraag_1": {
          "type": "vraag",
          "settings": {
            "vraag": "Is een set echt goedkoper dan de onderdelen los?",
            "antwoord": "<p>Op elke kaart staat een vanprijs. Dat is de prijs van dezelfde onderdelen los bij elkaar opgeteld. Het verschil tussen die twee is wat de set scheelt; het staat er als bedrag bij zodat je het niet hoeft uit te rekenen.</p>"
          }
        },
        "vraag_2": {
          "type": "vraag",
          "settings": {
            "vraag": "Wat is het verschil tussen een 1.0, 2.0 en 3.0?",
            "antwoord": "<p>Binnen één lijn is dat het aantal onderdelen. Bij de Skull-lijn is het apparaat in alle drie de sets hetzelfde en komt er per trede een tas bij. Bij de Barber-lijn komt er per trede een apparaat bij: eerst een shaver, dan een neustrimmer. Vergelijk daarom het aantal onderdelen op de kaart, niet het nummer.</p>"
          }
        },
        "vraag_3": {
          "type": "vraag",
          "settings": {
            "vraag": "Kan ik onderdelen later los bijkopen?",
            "antwoord": "<p>Ja. Mesjes, scheerkoppen en opzetstukken zijn los verkrijgbaar bij <a href=\"https://wellshave.com/collections/accesoires\">mesjes en accessoires</a>. Een set hoeft dus geen reserveonderdelen te bevatten.</p>"
          }
        },
        "vraag_4": {
          "type": "vraag",
          "settings": {
            "vraag": "Waarom kan ik de Barber Bro-sets niet bestellen?",
            "antwoord": "<p>Die drie zijn op dit moment niet leverbaar. Ze staan er nog wel bij, zodat je ze kunt vergelijken met de Barber Packs, die dezelfde opbouw hebben en wel op voorraad zijn.</p>"
          }
        },
        "vraag_5": {
          "type": "vraag",
          "settings": {
            "vraag": "Geldt de proefperiode ook op een set?",
            "antwoord": "<p>Ja, 100 dagen op de hele set. Je stuurt hem compleet terug; er hoeft niets ongeopend te blijven.</p>"
          }
        },
        "zone_1": {
          "type": "zone",
          "settings": {
