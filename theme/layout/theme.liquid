<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
 {%- render 'ecom_header' -%}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ 'Montserrat.ttf' | asset_url }}" type="font/ttf" crossorigin>
    {% comment %}theme-check-enable AssetPreload{% endcomment %}

    <title>
      {% liquid
        assign page_title_handleize = page_title | handleize
        assign shop_name_handleize = shop.name | handleize
      %}
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title_handleize contains shop_name_handleize %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {% render 'base' %}

    {%- comment -%}
      Het kortingslabel staat op de homepage, op de collectiepagina's en op elke
      productkaart. Eén keer hier inladen, zodat de regel niet bij elke kaart
      opnieuw in de pagina belandt.
    {%- endcomment -%}
    {{ 'ws-spaar.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  {% include 'pagefly-app-header' %}</head>

  <body>
    {% sections 'header-group' %}
    {% render 'cart-drawer' %}
    {%- if localization.available_countries.size > 1 -%}
      {% render 'localization' %}
    {%- endif -%}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  {%- render "ecom_footer"-%}</body>
</html>
