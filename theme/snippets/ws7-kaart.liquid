{%- comment -%}
  Productkaart voor de homepage v7. Naam, prijs, van-prijs, foto en link komen uit het product;
  een eigen foto (foto) gaat voor de productfoto.
  Het label rekent het percentage zoals ws-spaar: in centen, naar beneden afgerond.
  Gebruik: {% render 'ws7-kaart', product: p, foto: block.settings.foto, naam: block.settings.naam, wat: block.settings.wat, label: section.settings.label %}
{%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
<a class="ws7-kaart" href="{{ product.url | default: '#' }}">
  <span class="ws7-kaart__beeld">
    {%- if v.compare_at_price > v.price -%}
      {%- assign ws7_verschil = v.compare_at_price | minus: v.price -%}
      {%- assign ws7_pct = ws7_verschil | times: 100 | divided_by: v.compare_at_price -%}
      {%- if ws7_pct > 0 -%}<span class="ws7-label">{{ ws7_pct }}% {{ label | default: 'Korting' }}</span>{%- endif -%}
    {%- endif -%}
    {%- assign ws7_foto = foto | default: product.featured_image -%}
    {%- if ws7_foto -%}
      {{ ws7_foto | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320,480,640', sizes: '(max-width: 749px) 62vw, 320px', alt: ws7_foto.alt | default: product.title }}
    {%- endif -%}
  </span>
  <span class="ws7-kaart__naam">{{ naam | default: product.title }}</span>
  {%- if wat != blank -%}<span class="ws7-kaart__wat">{{ wat }}</span>{%- endif -%}
  <span class="ws7-kaart__prijs"><b>{% render 'ws-euro', bedrag: v.price %}</b>{%- if v.compare_at_price > v.price -%}<s>{% render 'ws-euro', bedrag: v.compare_at_price %}</s>{%- endif -%}</span>
</a>
