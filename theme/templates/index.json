    "ws_belofte": {
      "type": "ws-belofte",
      "blocks": {
        "r1": {"type": "review", "settings": {"quote": "“Doet wat hij moet doen. Ook bij de edele delen kun je zonder wondjes gaan trimmen. Ligt ook goed in de hand. Zeker goeie prijs kwaliteit.”", "naam": "Maarten A.", "product": "Groom Guard"}},
        "r2": {"type": "review", "settings": {"quote": "“Door de keramische bladen geen wondjes bij de schaamstreek. Scheermesjes? Prullenbak in!”", "naam": "Barend P.", "product": "Groom Guard PRO"}},
        "r3": {"type": "review", "settings": {"quote": "“Hele fijne en stille trimmer met accudisplay, dus nooit meer een lege batterij. Direct op de huid te gebruiken zonder sneetjes.”", "naam": "Aiden M.", "product": "Shave Package 3.0"}},
        "r4": {"type": "review", "settings": {"quote": "“Geweldig pakket, had ik eerder moeten kopen. Scheren gaat moeiteloos en zonder wondjes, zelfs de schaamstreek wordt super glad.”", "naam": "Rik T.", "product": "Shave Package Ultimate"}},
        "r5": {"type": "review", "settings": {"quote": "“Merk was nieuw voor mij, maar door de veelzijdigheid en reviews toch besteld. Snel geleverd en netjes verpakt. Scheerresultaat boven verwachting.”", "naam": "Britt J.", "product": "Gentleman Shaver Elite"}},
        "r6": {"type": "review", "settings": {"quote": "“Prettig apparaat, klein en ligt goed in de hand. Ik gebruik hem om mijn hoofd kaal te scheren, doet wat het belooft.”", "naam": "Emma B.", "product": "Head Shaver Deluxe"}},
        "r7": {"type": "review", "settings": {"quote": "“Fijn apparaat, werkt naar behoren. Als je de mesjes goed plat over de huid laat gaan kun je met een gerust hart scheren.”", "naam": "Lisa Z.", "product": "Flex Guard"}},
        "r8": {"type": "review", "settings": {"quote": "“Neustrim-opzetstuk kwijtgeraakt en kosteloos nageleverd door de klantenservice.”", "naam": "Aiden M.", "product": "Shave Package 3.0"}}
      },
