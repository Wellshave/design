    "ws_garantie": {
      "type": "ws-garantie",
      "blocks": {
        "g1": {"type": "zekerheid", "settings": {"icoon": "klok", "groot": "100 dagen", "wat": "Thuis proberen", "mits": "Niet goed? Dan krijg je je geld terug."}},
        "g2": {"type": "zekerheid", "settings": {"icoon": "schild", "groot": "2 jaar", "wat": "Garantie op elk apparaat", "mits": "Gaat er iets mis, dan lossen we het op."}},
        "g3": {"type": "zekerheid", "settings": {"icoon": "bus", "groot": "Gratis verzending", "wat": "In heel Nederland", "mits": "Naar België gratis vanaf €49,95."}},
        "g4": {"type": "zekerheid", "settings": {"icoon": "pakje", "groot": "Morgen in huis", "wat": "Besteld voor 23:59", "mits": "Nederland en België."}},
        "q1": {"type": "vraag", "settings": {"onderwerp": "Bestellen", "vraag": "Wat als het me toch niet bevalt?", "antwoord": "<p>Je hebt 100 dagen om het apparaat thuis te proberen. Bevalt het niet? Stuur het terug en ontvang het volledige aankoopbedrag. <strong>Je hoeft geen reden op te geven.</strong></p>"}},
        "q2": {"type": "vraag", "settings": {"onderwerp": "Bestellen", "vraag": "Wanneer is mijn bestelling binnen?", "antwoord": "<p>Bestel je voor 23:59, dan ligt je pakket de volgende dag in huis in Nederland en België. Duitsland en Oostenrijk duren één tot twee werkdagen, de rest van Europa twee tot drie.</p>"}},
        "q3": {"type": "vraag", "settings": {"onderwerp": "Bestellen", "vraag": "Wat kost verzending naar België?", "antwoord": "<p>Boven €49,95 gratis, daaronder €2,95. Binnen Nederland is verzending altijd gratis.</p>"}},
        "q4": {"type": "vraag", "settings": {"onderwerp": "Gebruik", "vraag": "Kan ik het apparaat onder de douche gebruiken?", "antwoord": "<p><strong>Niet allemaal.</strong> De meeste apparaten zijn waterdicht, maar niet alle. Op de productpagina staat per apparaat of hij nat gebruikt mag worden.</p>"}},
        "q5": {"type": "vraag", "settings": {"onderwerp": "Gebruik", "vraag": "Hoe vaak moet ik het mes vervangen?", "antwoord": "<p>Gemiddeld gaat een kop zes tot twaalf maanden mee, afhankelijk van hoe vaak je hem gebruikt. <strong>De koppen liggen apart op voorraad</strong>, dus een botte kop kost geen nieuw apparaat.</p>"}},
        "q6": {"type": "vraag", "settings": {"onderwerp": "Gebruik", "vraag": "Welk apparaat heb ik nodig?", "antwoord": "<p>Kies hierboven de zone waar je aan de slag wilt. Kom je er niet uit, stuur ons dan een bericht — dan denken we mee.</p>"}},
        "q7": {"type": "vraag", "settings": {"onderwerp": "Garantie", "vraag": "Wat valt er onder de garantie?", "antwoord": "<p>Twee jaar op het apparaat zelf. <strong>Scheerkoppen en messen zijn slijtdelen</strong> en vallen daarbuiten; die zijn los te bestellen.</p>"}},
        "q8": {"type": "vraag", "settings": {"onderwerp": "Garantie", "vraag": "Hoe stuur ik iets terug?", "antwoord": "<p>Stuur ons een bericht, dan krijg je van ons de instructies. <strong>De verzendkosten van de retour zijn voor jou</strong>, het aankoopbedrag krijg je volledig terug.</p>"}},
        "q9": {"type": "vraag", "settings": {"onderwerp": "Garantie", "vraag": "Hoe bereik ik jullie?", "antwoord": "<p>Per e-mail op contact@wellshave.com, of via het contactformulier. Je krijgt binnen één werkdag antwoord van een van ons.</p>"}}
