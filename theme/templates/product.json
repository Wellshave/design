        "r3": {
          "type": "review",
          "settings": {
            "titel": "Prima scheerapparaat voor een eerlijke prijs !",
            "tekst": "Prima scheerapparaat ! Gaat opgeladen heel lang mee en scheert heel glad. De scheerkop beweegt soepel mee met de contouren van de kaak.",
            "naam": "Pim van der Waal",
            "sterren": 5,
