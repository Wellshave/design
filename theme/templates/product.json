        "r2": {
          "type": "review",
          "settings": {
            "titel": "Bodyshaver van Wellshave doet netjes wat het moet doen",
            "tekst": "Bodyshaver van Wellshave gekocht voor een zeer schappelijke prijs en hij werkt prima. Hij trimt alles netjes, zonder bang te hoeven zijn voor wondjes. Top prijs-kwaliteit verhouding!",
            "naam": "Coen",
