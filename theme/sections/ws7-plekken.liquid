{% comment %} Wellshave v7 · plekken: grote foto's in een schuifrij, met een voortgangsbalk. {% endcomment %}
{{ 'ws7.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ws7.js' | asset_url }}" defer></script>
<section class="ws7{% if section.settings.wit %} ws7-wit{% endif %}">
  <div class="ws7-binnen ws7-midden">
    {%- if section.settings.oog != blank -%}<p class="ws7-oog">{{ section.settings.oog }}</p>{%- endif -%}
    {% render 'ws7-kop', kop: section.settings.kop, goud: section.settings.kop_goud %}
    {%- if section.settings.link_label != blank -%}<a class="ws7-link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}{% render 'ws7-pijl' %}</a>{%- endif -%}
    <div class="ws7-schuif">
      <div class="ws7-rij" tabindex="0" aria-label="Plekken, schuif opzij">
        {%- for block in section.blocks -%}
          <a class="ws7-plek" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            <span class="ws7-plek__beeld">{%- if block.settings.foto != blank -%}{%- assign ws7_stijl = 'object-position:' | append: block.settings.pos -%}{{ block.settings.foto | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '(max-width: 749px) 72vw, 30vw', alt: block.settings.foto.alt, style: ws7_stijl }}{%- endif -%}</span>
            <span class="ws7-plek__naam">{{ block.settings.titel }}</span>
            <span class="ws7-plek__nu">{{ block.settings.link_label | default: 'Shop nu' }}{% render 'ws7-pijl' %}</span>
          </a>
        {%- endfor -%}
      </div>
      {% render 'ws7-voortgang' %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "WS7 · Plekken",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "oog", "label": "Bovenregel" },
    { "type": "text", "id": "kop", "label": "Kop", "default": "Verzorgd" },
    { "type": "text", "id": "kop_goud", "label": "Kop, regel in goud", "default": "van top tot teen." },
    { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Shop alles" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "wit", "label": "Witte achtergrond", "default": false }
  ],
  "blocks": [
    { "type": "plek", "name": "Plek", "settings": [
      { "type": "image_picker", "id": "foto", "label": "Foto" },
      { "type": "text", "id": "pos", "label": "Uitsnede", "default": "50% 30%" },
      { "type": "text", "id": "titel", "label": "Naam", "default": "Lichaam" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Shop nu" }
    ]}
  ],
  "presets": [ { "name": "WS7 · Plekken" } ]
}
{% endschema %}
