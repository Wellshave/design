{% comment %}
  Wellshave — de quiz. Staat op een eigen pagina, niet op de homepage.
  Vier vragen, één uitkomst: voor wie → welke plek → wat wil je bereiken →
  waar loopt het nu op stuk.

  Twee bloktypes. "route" is één volledige weg door de quiz en draagt zijn
  eigen aanbeveling. "knelpunt" is één antwoord op vraag vier, per plek.
  Een route beantwoordt een knelpunt door de tekst ervan letterlijk in een
  van zijn drie antwoordvelden te zetten. Staat er niets, dan beweren we
  niets: dan wijst de kaart naar een apparaat in dezelfde plek dat het wel
  oplost, en heeft niemand dat, dan naar de honderd dagen.

  De zonevraag bouwt zichzelf op uit de zones die in de routeblokken staan —
  de eerste route van een zone levert de foto en de onderregel voor de
  zonekaart, en de knelpunten van die zone horen bij vraag vier.

  Prijs, van-prijs, besparing, voorraad en de koopknop komen uit het
  gekozen product. Er staat niets in dit blok dat niet uit Shopify of uit
  de eigen productteksten komt.

  Alle uitkomstkaarten staan van meet af aan in de HTML en worden door
  JavaScript getoond of verborgen. Dat is bewust: zo zijn de prijzen door
  Liquid gerenderd en klopt de pagina ook als er onderweg iets misgaat.
{% endcomment %}

{{ 'ws-quiz.css' | asset_url | stylesheet_tag }}

{% render 'indent-settings', section: section %}

{%- comment -%} De unieke zones, op volgorde van eerste voorkomen. Alleen
  routeblokken tellen mee: een knelpunt hoort bij een zone, maakt er geen. {%- endcomment -%}
{%- assign zonesleutel = '|' -%}
{%- for block in section.blocks -%}
  {%- unless block.type == 'route' -%}{%- continue -%}{%- endunless -%}
  {%- assign zoek = '|' | append: block.settings.zone | append: '|' -%}
  {%- unless zonesleutel contains zoek -%}
    {%- assign zonesleutel = zonesleutel | append: block.settings.zone | append: '|' -%}
  {%- endunless -%}
{%- endfor -%}
{%- assign zones = zonesleutel | remove_first: '|' | split: '|' -%}

<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <symbol id="ws-qz-terug" viewBox="0 0 24 24"><path d="M20 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="ws-qz-arw" viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="ws-qz-vink" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="ws-qz-persoon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4.8 20c0-3.6 3.2-5.8 7.2-5.8s7.2 2.2 7.2 5.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
  <symbol id="ws-qz-cadeau" viewBox="0 0 24 24"><path d="M3.6 11.4h16.8V20H3.6zM2.6 7.6h18.8v3.8H2.6zM12 7.6V20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M12 7.6S10.8 4 8.6 4a2 2 0 100 3.6M12 7.6S13.2 4 15.4 4a2 2 0 110 3.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
  <symbol id="ws-qz-opnieuw" viewBox="0 0 24 24"><path d="M20 12a8 8 0 11-2.6-5.9M20 4v4.4h-4.4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</svg>

<div class="ws-qz" data-ws-quiz><div class="ws-qz__in">

  <header class="ws-qz__kop">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ws-qz__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.kop != blank -%}
      <h1 class="ws-qz__h1">{{ section.settings.kop }}</h1>
    {%- endif -%}
    {%- if section.settings.sub != blank -%}
      <p class="ws-qz__sub">{{ section.settings.sub }}</p>
    {%- endif -%}
    {%- if section.settings.merk != blank -%}
      {{ section.settings.merk | image_url: width: 600 | image_tag: class: 'ws-qz__merk', alt: '', loading: 'lazy' }}
    {%- endif -%}
  </header>

  <div class="ws-qz__balk" data-qz-balk>
    <button class="ws-qz__terug" type="button" data-qz-terug hidden>
      <svg><use href="#ws-qz-terug"/></svg>{{ section.settings.terug }}
    </button>
    <ol class="ws-qz__stappen">
      <li data-qz-stip="1"><i>1</i><span>{{ section.settings.stap_1 }}</span></li>
      <li data-qz-stip="2"><i>2</i><span>{{ section.settings.stap_2 }}</span></li>
      <li data-qz-stip="3"><i>3</i><span>{{ section.settings.stap_3 }}</span></li>
      <li data-qz-stip="4"><i>4</i><span>{{ section.settings.stap_4 }}</span></li>
    </ol>
  </div>

  {%- comment -%} ─── Vraag 1: voor wie ─── {%- endcomment -%}
  <section class="ws-qz__vak" data-qz-vak="wie">
    <p class="ws-qz__vraag">{{ section.settings.v1_kop }}</p>
    {%- if section.settings.v1_sub != blank -%}
      <p class="ws-qz__vraagsub">{{ section.settings.v1_sub }}</p>
    {%- endif -%}
    <div class="ws-qz__twee">
      <button class="ws-qz__kaart ws-qz__kaart--wie" type="button" data-qz-wie="zelf">
        <span class="ws-qz__ring"><svg><use href="#ws-qz-persoon"/></svg></span>
        <b>{{ section.settings.v1_zelf }}</b>
        <span>{{ section.settings.v1_zelf_wat }}</span>
      </button>
      <button class="ws-qz__kaart ws-qz__kaart--wie" type="button" data-qz-wie="cadeau">
        <span class="ws-qz__ring"><svg><use href="#ws-qz-cadeau"/></svg></span>
        <b>{{ section.settings.v1_cadeau }}</b>
        <span>{{ section.settings.v1_cadeau_wat }}</span>
      </button>
    </div>
  </section>

  {%- comment -%} ─── Vraag 2: welke zone ─── {%- endcomment -%}
  <section class="ws-qz__vak" data-qz-vak="zone" hidden>
    <p class="ws-qz__vraag">{{ section.settings.v2_kop }}</p>
    {%- if section.settings.v2_sub != blank -%}
      <p class="ws-qz__vraagsub">{{ section.settings.v2_sub }}</p>
    {%- endif -%}
    <div class="ws-qz__zones">
      {%- for z in zones -%}
        {%- assign gevonden = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'route' and block.settings.zone == z and gevonden == false -%}
            {%- assign eerste = block -%}
            {%- assign gevonden = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign aantal = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'route' and block.settings.zone == z -%}{%- assign aantal = aantal | plus: 1 -%}{%- endif -%}
        {%- endfor -%}
        <button class="ws-qz__zone" type="button" data-qz-zone="{{ z | escape }}" data-qz-routes="{{ aantal }}">
          <span class="ws-qz__zonebeeld">
            {%- if eerste.settings.zone_foto != blank -%}
              {{ eerste.settings.zone_foto | image_url: width: 560 | image_tag: alt: '', loading: 'lazy' }}
            {%- endif -%}
          </span>
          <span class="ws-qz__zonetekst">
            <b>{{ z }}</b>
            {%- if eerste.settings.zone_wat != blank -%}
              <span>{{ eerste.settings.zone_wat }}</span>
            {%- endif -%}
          </span>
          <svg class="ws-qz__zonepijl"><use href="#ws-qz-arw"/></svg>
        </button>
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ─── Vraag 3: wat wil je bereiken ─── {%- endcomment -%}
  <section class="ws-qz__vak" data-qz-vak="keuze" hidden>
    <p class="ws-qz__vraag" data-qz-v3kop>{{ section.settings.v3_kop }}</p>
    {%- if section.settings.v3_sub != blank -%}
      <p class="ws-qz__vraagsub">{{ section.settings.v3_sub }}</p>
    {%- endif -%}
    {%- for z in zones -%}
      <div class="ws-qz__keuzes" data-qz-keuzes="{{ z | escape }}" hidden>
        {%- for block in section.blocks -%}
          {%- if block.type == 'route' and block.settings.zone == z -%}
            <button class="ws-qz__kaart" type="button" data-qz-route="{{ block.id }}" {{ block.shopify_attributes }}>
              <b>{{ block.settings.keuze }}</b>
              {%- if block.settings.keuze_wat != blank -%}
                <span>{{ block.settings.keuze_wat }}</span>
              {%- endif -%}
              <svg class="ws-qz__kaartpijl"><use href="#ws-qz-arw"/></svg>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </section>

  {%- comment -%} ─── Vraag 4: waar loopt het op stuk ─── {%- endcomment -%}
  <section class="ws-qz__vak" data-qz-vak="knel" hidden>
    <p class="ws-qz__vraag">{{ section.settings.v4_kop }}</p>
    {%- if section.settings.v4_sub != blank -%}
      <p class="ws-qz__vraagsub">{{ section.settings.v4_sub }}</p>
    {%- endif -%}
    {%- for z in zones -%}
      <div class="ws-qz__keuzes" data-qz-knelgroep="{{ z | escape }}" hidden>
        {%- for knel in section.blocks -%}
          {%- if knel.type == 'knelpunt' and knel.settings.zone == z -%}
            <button class="ws-qz__kaart" type="button" data-qz-knelkeuze="{{ knel.id }}" {{ knel.shopify_attributes }}>
              <b>{{ knel.settings.label }}</b>
              {%- if knel.settings.wat != blank -%}
                <span>{{ knel.settings.wat }}</span>
              {%- endif -%}
              <svg class="ws-qz__kaartpijl"><use href="#ws-qz-arw"/></svg>
            </button>
          {%- endif -%}
        {%- endfor -%}
        <button class="ws-qz__kaart" type="button" data-qz-knelkeuze="geen">
          <b>{{ section.settings.geen_label }}</b>
          {%- if section.settings.geen_wat != blank -%}
            <span>{{ section.settings.geen_wat }}</span>
          {%- endif -%}
          <svg class="ws-qz__kaartpijl"><use href="#ws-qz-arw"/></svg>
        </button>
      </div>
    {%- endfor -%}
  </section>

  {%- comment -%} ─── De uitkomst ─── {%- endcomment -%}
  <section class="ws-qz__vak ws-qz__vak--uit" data-qz-vak="uit" hidden>

    {%- for block in section.blocks -%}
      {%- unless block.type == 'route' -%}{%- continue -%}{%- endunless -%}
      {%- assign p = block.settings.product -%}
      {%- assign v = p.selected_or_first_available_variant -%}
      <article class="ws-qz__uitkomst" data-qz-uit="{{ block.id }}" hidden>
        <p class="ws-qz__uitlabel"><svg><use href="#ws-qz-vink"/></svg>{{ section.settings.uit_label }}</p>
        <div class="ws-qz__uitbody">

          <div class="ws-qz__uitbeeld">
            {%- if block.settings.foto != blank -%}
              {{ block.settings.foto | image_url: width: 900 | image_tag: alt: '', loading: 'lazy' }}
            {%- elsif p.featured_image -%}
              {{ p.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}
            {%- endif -%}
            {%- if block.settings.pil != blank -%}
              <span class="ws-qz__pil">{{ block.settings.pil }}</span>
            {%- endif -%}
          </div>

          <div class="ws-qz__uitkaart">
            <p class="ws-qz__uitzone">{{ block.settings.zone }} · {{ block.settings.keuze }}</p>
            <h2 class="ws-qz__uitnaam">{{ block.settings.naam | default: p.title }}</h2>
            {%- if block.settings.waarom != blank -%}
              <p class="ws-qz__waarom">{{ block.settings.waarom }}</p>
            {%- endif -%}

            {%- comment -%} Wat het gekozen knelpunt voor dit apparaat betekent.
              Alle varianten staan er, JavaScript toont er één. {%- endcomment -%}
            {%- for knel in section.blocks -%}
              {%- if knel.type == 'knelpunt' and knel.settings.zone == block.settings.zone -%}
                {%- assign eigen = '' -%}
                {%- if block.settings.antw_1_bij == knel.settings.label -%}{%- assign eigen = block.settings.antw_1 -%}{%- endif -%}
                {%- if block.settings.antw_2_bij == knel.settings.label -%}{%- assign eigen = block.settings.antw_2 -%}{%- endif -%}
                {%- if block.settings.antw_3_bij == knel.settings.label -%}{%- assign eigen = block.settings.antw_3 -%}{%- endif -%}
                <div class="ws-qz__knel" data-qz-knel="{{ knel.id }}" hidden>
                  <p class="ws-qz__knelkop">{{ section.settings.knel_kop }} {{ knel.settings.label | downcase }}</p>
                  {%- if eigen != blank -%}
                    <p>{{ eigen }}</p>
                  {%- else -%}
                    <p class="ws-qz__knelzacht">{{ section.settings.knel_niet }}</p>
                    {%- comment -%} Lost een ander apparaat in dezelfde zone dit
                      wel op? Dan wijzen we daarheen in plaats van iets te
                      beloven. De drie hulpvariabelen moeten per knelpunt leeg
                      beginnen: een assign in een lus blijft anders staan. {%- endcomment -%}
                    {%- assign zusid = '' -%}
                    {%- assign zusnaam = '' -%}
                    {%- assign zustekst = '' -%}
                    {%- for zus in section.blocks -%}
                      {%- if zus.type == 'route' and zus.settings.zone == block.settings.zone and zus.id != block.id and zustekst == blank -%}
                        {%- if zus.settings.antw_1_bij == knel.settings.label and zus.settings.antw_1 != blank -%}
                          {%- assign zustekst = zus.settings.antw_1 -%}
                        {%- elsif zus.settings.antw_2_bij == knel.settings.label and zus.settings.antw_2 != blank -%}
                          {%- assign zustekst = zus.settings.antw_2 -%}
                        {%- elsif zus.settings.antw_3_bij == knel.settings.label and zus.settings.antw_3 != blank -%}
                          {%- assign zustekst = zus.settings.antw_3 -%}
                        {%- endif -%}
                        {%- if zustekst != blank -%}
                          {%- assign zusid = zus.id -%}
                          {%- assign zusnaam = zus.settings.naam | default: zus.settings.product.title | strip_html -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if zustekst != blank -%}
                      <p class="ws-qz__knelwijzer">{{ section.settings.knel_wel }}
                        <button type="button" data-qz-route="{{ zusid }}">{{ zusnaam }}</button> — {{ zustekst }}</p>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
            <div class="ws-qz__knel" data-qz-knel="geen" hidden>
              <p class="ws-qz__knelkop">{{ section.settings.geen_kop }}</p>
              <p>{{ section.settings.geen_tekst }}</p>
            </div>

            {%- if block.settings.punt_1 != blank or block.settings.punt_2 != blank or block.settings.punt_3 != blank -%}
              <ul class="ws-qz__punten">
                {%- if block.settings.punt_1 != blank -%}<li><svg><use href="#ws-qz-vink"/></svg>{{ block.settings.punt_1 }}</li>{%- endif -%}
                {%- if block.settings.punt_2 != blank -%}<li><svg><use href="#ws-qz-vink"/></svg>{{ block.settings.punt_2 }}</li>{%- endif -%}
                {%- if block.settings.punt_3 != blank -%}<li><svg><use href="#ws-qz-vink"/></svg>{{ block.settings.punt_3 }}</li>{%- endif -%}
              </ul>
            {%- endif -%}

            {%- if p != blank -%}
              <p class="ws-qz__prijs">
                <span class="ws-qz__nu">{{ v.price | money }}</span>
                {%- if v.compare_at_price > v.price -%}
                  <span class="ws-qz__was">{{ v.compare_at_price | money }}</span>
                  <span class="ws-qz__korting">{{ section.settings.bespaar }} {{ v.compare_at_price | minus: v.price | money }}</span>
                {%- endif -%}
              </p>
              <p class="ws-qz__voorraad"><span class="ws-qz__stip"></span>
                {%- if v.available -%}{{ section.settings.voorraad_wel }}{%- else -%}{{ section.settings.voorraad_niet }}{%- endif -%}</p>
              {%- comment -%} Het id eerst opbouwen: een filter in het argument
                zelf laat Liquid block.id als formuliertype lezen. {%- endcomment -%}
              {%- assign formulier_id = 'ws-qz-form-' | append: block.id -%}
              {%- form 'product', p, id: formulier_id -%}
                <input type="hidden" name="id" value="{{ v.id }}">
                {%- comment -%} Dit thema heeft geen winkelwagenpagina: /cart stuurt
                  door naar de homepage. Zonder return_to komt de koper daar dus
                  uit in plaats van bij zijn bestelling. Nu gaat hij in één klik
                  naar de kassa, met wat er al in zijn mandje zat. {%- endcomment -%}
                <input type="hidden" name="return_to" value="/checkout">
                <button class="ws-qz__knop" type="submit" {% unless v.available %}disabled{% endunless %}>
                  {{ section.settings.knop }}<span><svg><use href="#ws-qz-arw"/></svg></span>
                </button>
              {%- endform -%}
              <p class="ws-qz__meer"><a href="{{ p.url }}">{{ section.settings.meer }}</a></p>
            {%- endif -%}
          </div>
        </div>

        {%- comment -%} De andere routes binnen dezelfde zone, als alternatief. {%- endcomment -%}
        {%- assign anders = 0 -%}
        {%- for zus in section.blocks -%}
          {%- if zus.type == 'route' and zus.settings.zone == block.settings.zone and zus.id != block.id -%}
            {%- assign anders = anders | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if anders > 0 -%}
          <div class="ws-qz__anders">
            <p>{{ section.settings.anders_kop }}</p>
            <div>
              {%- for zus in section.blocks -%}
                {%- if zus.type == 'route' and zus.settings.zone == block.settings.zone and zus.id != block.id -%}
                  <button class="ws-qz__chip" type="button" data-qz-route="{{ zus.id }}">
                    {{ zus.settings.keuze }} — {{ zus.settings.naam | default: zus.settings.product.title }}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </article>
    {%- endfor -%}

    {%- comment -%} De cadeauroute: één vaste bundel, geen zonevragen. {%- endcomment -%}
    {%- assign cp = section.settings.cadeau_product -%}
    {%- assign cv = cp.selected_or_first_available_variant -%}
    <article class="ws-qz__uitkomst" data-qz-uit="cadeau" hidden>
      <p class="ws-qz__uitlabel"><svg><use href="#ws-qz-vink"/></svg>{{ section.settings.cadeau_label }}</p>
      <div class="ws-qz__uitbody">
        <div class="ws-qz__uitbeeld">
          {%- if section.settings.cadeau_foto != blank -%}
            {{ section.settings.cadeau_foto | image_url: width: 900 | image_tag: alt: '', loading: 'lazy' }}
          {%- elsif cp.featured_image -%}
            {{ cp.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}
          {%- endif -%}
          {%- if section.settings.cadeau_pil != blank -%}
            <span class="ws-qz__pil">{{ section.settings.cadeau_pil }}</span>
          {%- endif -%}
        </div>
        <div class="ws-qz__uitkaart">
          <p class="ws-qz__uitzone">{{ section.settings.cadeau_zone }}</p>
          <h2 class="ws-qz__uitnaam">{{ section.settings.cadeau_naam | default: cp.title }}</h2>
          {%- if section.settings.cadeau_waarom != blank -%}
            <p class="ws-qz__waarom">{{ section.settings.cadeau_waarom }}</p>
          {%- endif -%}
          {%- if section.settings.cadeau_punt_1 != blank or section.settings.cadeau_punt_2 != blank or section.settings.cadeau_punt_3 != blank -%}
            <ul class="ws-qz__punten">
              {%- if section.settings.cadeau_punt_1 != blank -%}<li><svg><use href="#ws-qz-vink"/></svg>{{ section.settings.cadeau_punt_1 }}</li>{%- endif -%}
              {%- if section.settings.cadeau_punt_2 != blank -%}<li><svg><use href="#ws-qz-vink"/></svg>{{ section.settings.cadeau_punt_2 }}</li>{%- endif -%}
              {%- if section.settings.cadeau_punt_3 != blank -%}<li><svg><use href="#ws-qz-vink"/></svg>{{ section.settings.cadeau_punt_3 }}</li>{%- endif -%}
            </ul>
          {%- endif -%}
          {%- if cp != blank -%}
            <p class="ws-qz__prijs">
              <span class="ws-qz__nu">{{ cv.price | money }}</span>
              {%- if cv.compare_at_price > cv.price -%}
                <span class="ws-qz__was">{{ cv.compare_at_price | money }}</span>
                <span class="ws-qz__korting">{{ section.settings.bespaar }} {{ cv.compare_at_price | minus: cv.price | money }}</span>
              {%- endif -%}
            </p>
            <p class="ws-qz__voorraad"><span class="ws-qz__stip"></span>
              {%- if cv.available -%}{{ section.settings.voorraad_wel }}{%- else -%}{{ section.settings.voorraad_niet }}{%- endif -%}</p>
            {%- form 'product', cp, id: 'ws-qz-form-cadeau' -%}
              <input type="hidden" name="id" value="{{ cv.id }}">
              <input type="hidden" name="return_to" value="/checkout">
              <button class="ws-qz__knop" type="submit" {% unless cv.available %}disabled{% endunless %}>
                {{ section.settings.knop }}<span><svg><use href="#ws-qz-arw"/></svg></span>
              </button>
            {%- endform -%}
            <p class="ws-qz__meer"><a href="{{ cp.url }}">{{ section.settings.meer }}</a></p>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.cadeau_anders != blank -%}
        <div class="ws-qz__anders">
          <p>{{ section.settings.cadeau_anders }}</p>
          <div><button class="ws-qz__chip" type="button" data-qz-opnieuw>{{ section.settings.cadeau_anders_knop }}</button></div>
        </div>
      {%- endif -%}
    </article>

    <div class="ws-qz__voet">
      <button class="ws-qz__opnieuw" type="button" data-qz-opnieuw>
        <svg><use href="#ws-qz-opnieuw"/></svg>{{ section.settings.opnieuw }}
      </button>
      {%- if section.settings.zeker_1 != blank or section.settings.zeker_2 != blank or section.settings.zeker_3 != blank -%}
        <p class="ws-qz__zeker">
          {%- if section.settings.zeker_1 != blank -%}<span>{{ section.settings.zeker_1 }}</span>{%- endif -%}
          {%- if section.settings.zeker_2 != blank -%}<span>{{ section.settings.zeker_2 }}</span>{%- endif -%}
          {%- if section.settings.zeker_3 != blank -%}<span>{{ section.settings.zeker_3 }}</span>{%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </section>

</div></div>

<script>
  (function () {
    document.querySelectorAll('[data-ws-quiz]').forEach(function (wortel) {
      if (wortel.dataset.wsKlaar) return;
      wortel.dataset.wsKlaar = '1';

      var vakken = {};
      wortel.querySelectorAll('[data-qz-vak]').forEach(function (v) { vakken[v.dataset.qzVak] = v; });
      var stippen = wortel.querySelectorAll('[data-qz-stip]');
      var terug = wortel.querySelector('[data-qz-terug]');
      var v3kop = wortel.querySelector('[data-qz-v3kop]');
      var v3sjabloon = v3kop ? v3kop.textContent : '';
      var pad = [];
      // Wat er tot nu toe gekozen is. De knelpuntkeuze moet bewaard blijven
      // als je onderaan via een chip naar een ander apparaat springt.
      var zone = null, route = null, knel = null;

      function toon(naam) {
        Object.keys(vakken).forEach(function (k) { vakken[k].hidden = k !== naam; });
        var nr = naam === 'wie' ? 1 : naam === 'zone' ? 2 : naam === 'keuze' ? 3 : 4;
        stippen.forEach(function (s) {
          var eigen = parseInt(s.dataset.qzStip, 10);
          s.classList.toggle('is-aan', eigen === nr && naam !== 'uit');
          s.classList.toggle('is-klaar', eigen < nr || naam === 'uit');
        });
        if (terug) terug.hidden = pad.length === 0;
        // Bij een nieuwe stap springt de blik naar de vraag, niet naar de paginatop.
        var doel = vakken[naam];
        if (doel && pad.length) {
          var y = doel.getBoundingClientRect().top + window.pageYOffset - 90;
          window.scrollTo({ top: y < 0 ? 0 : y, behavior: 'smooth' });
        }
      }

      function toonUitkomst(sleutel) {
        wortel.querySelectorAll('[data-qz-uit]').forEach(function (u) {
          u.hidden = u.dataset.qzUit !== sleutel;
          u.querySelectorAll('[data-qz-knel]').forEach(function (k) {
            k.hidden = k.dataset.qzKnel !== knel;
          });
        });
        toon('uit');
      }

      // Na de routekeuze komt vraag 4 — tenzij er voor deze plek geen
      // knelpunten zijn ingevuld. Dan zou het een vraag met één antwoord zijn.
      function naKeuze(routeId) {
        route = routeId;
        var groep = null;
        wortel.querySelectorAll('[data-qz-knelgroep]').forEach(function (g) {
          var raak = g.dataset.qzKnelgroep === zone;
          g.hidden = !raak;
          if (raak) groep = g;
        });
        var echte = groep ? groep.querySelectorAll('[data-qz-knelkeuze]:not([data-qz-knelkeuze="geen"])') : [];
        if (!echte.length) { toonUitkomst(routeId); return; }
        toon('knel');
      }

      wortel.querySelectorAll('[data-qz-wie]').forEach(function (knop) {
        knop.addEventListener('click', function () {
          if (knop.dataset.qzWie === 'cadeau') {
            pad.push('wie');
            toonUitkomst('cadeau');
          } else {
            pad.push('wie');
            toon('zone');
          }
        });
      });

      wortel.querySelectorAll('[data-qz-zone]').forEach(function (knop) {
        knop.addEventListener('click', function () {
          zone = knop.dataset.qzZone;
          var groepen = wortel.querySelectorAll('[data-qz-keuzes]');
          var mijn = null;
          groepen.forEach(function (g) {
            var raak = g.dataset.qzKeuzes === zone;
            g.hidden = !raak;
            if (raak) mijn = g;
          });
          knel = null;
          pad.push('zone');
          // Eén route in deze zone? Dan is er niets te kiezen en slaan we vraag 3 over.
          var routes = mijn ? mijn.querySelectorAll('[data-qz-route]') : [];
          if (routes.length === 1) {
            naKeuze(routes[0].dataset.qzRoute);
            return;
          }
          if (v3kop && v3sjabloon.indexOf('{zone}') !== -1) {
            v3kop.textContent = v3sjabloon.replace('{zone}', zone.toLowerCase());
          }
          toon('keuze');
        });
      });

      wortel.querySelectorAll('[data-qz-route]').forEach(function (knop) {
        knop.addEventListener('click', function () {
          // Vanuit een alternatief-chip of de knelpuntwijzer staan we al op de
          // uitkomst; dan geen stap erbij, en het knelpunt blijft staan.
          if (!vakken.uit.hidden) {
            route = knop.dataset.qzRoute;
            toonUitkomst(route);
            return;
          }
          pad.push('keuze');
          naKeuze(knop.dataset.qzRoute);
        });
      });

      wortel.querySelectorAll('[data-qz-knelkeuze]').forEach(function (knop) {
        knop.addEventListener('click', function () {
          knel = knop.dataset.qzKnelkeuze;
          pad.push('knel');
          toonUitkomst(route);
        });
      });

      wortel.querySelectorAll('[data-qz-opnieuw]').forEach(function (knop) {
        knop.addEventListener('click', function () {
          pad = [];
          zone = null; route = null; knel = null;
          toon('wie');
        });
      });

      if (terug) {
        terug.addEventListener('click', function () {
          var vorige = pad.pop();
          toon(vorige || 'wie');
        });
      }

      toon('wie');
    });
  })();
</script>

