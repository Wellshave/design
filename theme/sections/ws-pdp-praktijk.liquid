{%- comment -%}
  Wellshave — productpagina, blok 05: in de praktijk.
  Vervangt de oude sectie product-media-with-text.

  Leest custom.image_with_text: een lijst metaobjecten met title, description
  (rijke tekst), image óf video, en label. Het veld media_position wordt niet
  meer gelezen — de kaarten wisselen automatisch van kant, zodat het nooit
  meer per product met de hand goed gezet hoeft te worden.

  De video's spelen vanzelf af zodra ze in beeld komen, en pauzeren zodra ze
  eruit zijn. Ze staan op preload="none" tot dat moment, dus de oude fout
  komt niet terug: vier video's die tegelijk laden terwijl niemand ze ziet.
  Lukt automatisch afspelen niet — beweging uitgezet, of de browser weigert
  het — dan wordt het etiket alsnog een echte speelknop.
{%- endcomment -%}

{{ 'ws-pdp-praktijk.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign lijst = product.metafields.custom.image_with_text.value
-%}

{%- if lijst != blank -%}
  {%- comment -%}
    Eerst tellen hoeveel er echt beeld hebben. Een metaobject zonder foto en
    zonder video zou anders een halve kaart opleveren.
  {%- endcomment -%}
  {%- assign aantal = 0 -%}
  {%- for item in lijst -%}
    {%- if item.image.value != blank or item.video.value != blank -%}
      {%- assign aantal = aantal | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if aantal > 0 -%}
    {%- liquid
      assign uid = section.id
      comment
        De telwoorden stonden hier in het Nederlands vastgetimmerd, dus op de
        Engelse pagina stond "Vier moments". Ze komen nu uit een instelling,
        zodat ze net als de rest per taal vertaald kunnen worden.
      endcomment
      assign woordenlijst = s.telwoorden | default: 'nul,Eén,Twee,Drie,Vier,Vijf,Zes,Zeven,Acht,Negen,Tien'
      assign woorden = woordenlijst | split: ','
      if aantal <= 10
        assign telwoord = woorden[aantal]
      else
        assign telwoord = aantal
      endif
      assign kop = s.kop | replace: '[aantal]', telwoord | replace: '[product]', product.title
    -%}

    <section class="ws-prk" data-ws-prk
             style="--p-top:{{ s.marge_top }}px;--p-bot:{{ s.marge_bot }}px
                    {%- if s.zand_a != blank %};--p-zand-a:{{ s.zand_a }}{% endif -%}
                    {%- if s.zand_b != blank %};--p-zand-b:{{ s.zand_b }}{% endif -%}">
      <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <symbol id="ws-prk-play-{{ uid }}" viewBox="0 0 24 24"><path d="M8 5.4v13.2L19 12z" fill="currentColor"/></symbol>
      </svg>

      <div class="ws-prk-rail">
        {%- if s.eyebrow != blank or kop != blank -%}
          <header class="ws-prk-hd">
            {%- if s.eyebrow != blank -%}
              <span class="ws-prk-ey">{{ s.eyebrow }}</span>
            {%- endif -%}
            {%- if kop != blank -%}<h2>{{ kop }}</h2>{%- endif -%}
          </header>
        {%- endif -%}

        {%- assign teller = 0 -%}
        {%- for item in lijst -%}
          {%- liquid
            assign beeld = item.image.value
            assign film = item.video.value
          -%}
          {%- if beeld == blank and film == blank -%}{%- continue -%}{%- endif -%}
          {%- assign teller = teller | plus: 1 -%}

          {%- comment -%}
            Even kaarten krijgen het beeld aan de andere kant. Begint bij
            links, tenzij de instelling anders zegt.
          {%- endcomment -%}
          {%- assign rest = teller | modulo: 2 -%}
          {%- if s.beeld_links -%}
            {%- if rest == 0 -%}{%- assign omgekeerd = true -%}{%- else -%}{%- assign omgekeerd = false -%}{%- endif -%}
          {%- else -%}
            {%- if rest == 0 -%}{%- assign omgekeerd = false -%}{%- else -%}{%- assign omgekeerd = true -%}{%- endif -%}
          {%- endif -%}

          {%- capture nummer -%}{% if teller < 10 %}0{% endif %}{{ teller }}{%- endcapture -%}

          <article class="ws-prk-kaart{% if omgekeerd %} ws-om{% endif %}">
            <div class="ws-prk-md">
              {%- if film != blank -%}
                <video class="ws-prk-v" playsinline muted loop preload="none"
                       poster="{{ film.preview_image | image_url: width: 1100 }}"
                       {% if item.title.value != blank %}aria-label="{{ item.title.value | escape }}"{% endif %}>
                  {%- for bron in film.sources -%}
                    {%- if bron.format == 'mp4' -%}
                      <source src="{{ bron.url }}" type="{{ bron.mime_type }}">
                    {%- endif -%}
                  {%- endfor -%}
                </video>
                {%- comment -%}
                  Een etiket, geen knop: de video speelt vanzelf. Alleen als
                  dat niet lukt maakt het script er een echte knop van.
                {%- endcomment -%}
                {%- if s.video_label != blank -%}
                  <span class="ws-prk-etiket" aria-hidden="true">
                    <i><svg><use href="#ws-prk-play-{{ uid }}"/></svg></i>{{ s.video_label }}
                  </span>
                {%- endif -%}
              {%- else -%}
                {{ beeld | image_url: width: 1100 | image_tag: alt: item.title.value, loading: 'lazy', class: 'ws-prk-f' }}
              {%- endif -%}
            </div>

            <div class="ws-prk-tx">
              <span class="ws-prk-nr" aria-hidden="true">{{ nummer }}</span>

              <p class="ws-prk-kick">
                <b>{{ nummer }}</b>
                {%- if item.label.value != blank -%}<em>&middot;</em>{{ item.label.value }}{%- endif -%}
              </p>

              {%- if item.title.value != blank -%}<h3>{{ item.title.value }}</h3>{%- endif -%}

              {%- comment -%}
                Rijke tekst rendert een alinea plus een lijst. De alinea is de
                uitleg, de lijstpunten worden de vinkjes — dat scheelt een
                tweede veld en het staat er al.
              {%- endcomment -%}
              {%- if item.description.value != blank -%}
                <div class="ws-prk-body">{{ item.description | metafield_tag }}</div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </section>

    <script>
      (function () {
        var wortel = document.currentScript.previousElementSibling;
        if (!wortel || !wortel.hasAttribute('data-ws-prk')) { return; }

        var films = Array.prototype.slice.call(wortel.querySelectorAll('.ws-prk-v'));
        if (!films.length) { return; }

        var stil = false;
        try { stil = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

        function speel(film) {
          if (!film.paused) { return; }
          if (film.preload === 'none') { film.preload = 'auto'; }
          film.muted = true;
          var belofte = film.play();
          if (belofte && belofte.catch) {
            belofte.catch(function (fout) {
              // Scrollt de kaart weer uit beeld voordat het afspelen begonnen
              // is, dan breekt de browser de belofte af met AbortError. Dat is
              // geen weigering; alleen een echte weigering krijgt een knop.
              if (fout && fout.name === 'AbortError') { return; }
              metDeHand(film);
            });
          }
        }

        // Lukt afspelen niet, dan wordt het beeldvlak alsnog een knop. Beter
        // een knop die werkt dan een poster die niets doet.
        function metDeHand(film) {
          var doos = film.parentNode;
          if (doos.classList.contains('ws-handmatig')) { return; }
          doos.classList.add('ws-handmatig');
          doos.setAttribute('role', 'button');
          doos.setAttribute('tabindex', '0');
          var naam = film.getAttribute('aria-label');
          doos.setAttribute('aria-label', naam ? 'Speel af: ' + naam : 'Speel de video af');

          function start(e) {
            if (e.type === 'keydown' && e.key !== 'Enter' && e.key !== ' ') { return; }
            e.preventDefault();
            doos.classList.remove('ws-handmatig');
            doos.removeAttribute('role');
            doos.removeAttribute('tabindex');
            doos.removeAttribute('aria-label');
            doos.removeEventListener('click', start);
            doos.removeEventListener('keydown', start);
            if (film.preload === 'none') { film.preload = 'auto'; }
            film.muted = true;
            var b = film.play();
            if (b && b.catch) { b.catch(function () {}); }
          }
          doos.addEventListener('click', start);
          doos.addEventListener('keydown', start);
        }

        function herstel(film) {
          var doos = film.parentNode;
          doos.classList.remove('ws-handmatig');
          doos.removeAttribute('role');
          doos.removeAttribute('tabindex');
          doos.removeAttribute('aria-label');
        }

        if (stil || !('IntersectionObserver' in window)) {
          films.forEach(metDeHand);
          return;
        }

        // Pas laden en afspelen als de kaart echt in beeld staat, en weer
        // pauzeren zodra hij eruit is. Dat scheelt data en accu.
        var kijker = new IntersectionObserver(function (regels) {
          regels.forEach(function (regel) {
            var film = regel.target;
            if (regel.isIntersecting) {
              speel(film);
            } else if (!film.paused) {
              film.pause();
            } else if (film.parentNode.classList.contains('ws-handmatig')) {
              // Buiten beeld heeft een knop geen zin; bij terugkomst
              // proberen we het gewoon opnieuw.
              herstel(film);
            }
          });
        }, { threshold: 0.4 });

        films.forEach(function (film) { kijker.observe(film); });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Wellshave PDP — Praktijk",
  "tag": "section",
  "class": "ws-pdp-praktijk-sectie",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "De kop" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "info": "Staat in een randje boven de kop. Leeg = geen randje.", "default": "In de praktijk" },
    { "type": "text", "id": "kop", "label": "Kop", "info": "[aantal] wordt het aantal kaarten als woord, [product] de producttitel.", "default": "[aantal] momenten. Eén moeiteloze routine." },
    { "type": "text", "id": "telwoorden", "label": "Telwoorden voor [aantal]", "info": "Nul tot en met tien, door komma's gescheiden. Staat er niets, dan komt het getal er als cijfer te staan.", "default": "nul,Eén,Twee,Drie,Vier,Vijf,Zes,Zeven,Acht,Negen,Tien" },

    { "type": "header", "content": "De kaarten" },
    { "type": "checkbox", "id": "beeld_links", "label": "Eerste kaart: beeld links", "info": "Daarna wisselt het vanzelf om en om.", "default": true },
    { "type": "text", "id": "video_label", "label": "Etiket op de video", "info": "Alleen een merkteken; de video speelt vanzelf. Leeg = geen etiket.", "default": "Video" },
    { "type": "color", "id": "zand_a", "label": "Zand — oneven kaarten", "default": "#FBF8F1" },
    { "type": "color", "id": "zand_b", "label": "Zand — even kaarten", "default": "#F0E8D8" },

    { "type": "header", "content": "Ruimte" },
    { "type": "range", "id": "marge_top", "label": "Ruimte boven", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "marge_bot", "label": "Ruimte onder", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Wellshave PDP — Praktijk" }]
}
{% endschema %}
