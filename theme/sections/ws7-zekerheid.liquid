{% comment %} Wellshave v7 · zekerheidsstrook: ronde icoonvlakken, gescheiden door haarlijnen. {% endcomment %}
{{ 'ws7.css' | asset_url | stylesheet_tag }}
<div class="ws7 ws7-zeker{% if section.settings.wit %} ws7-wit{% endif %}">
  {%- for block in section.blocks -%}
    <span class="ws7-zeker__item" {{ block.shopify_attributes }}>
      {%- case block.settings.icoon -%}
        {%- when 'ster' -%}<svg class="ws7-ster" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z"/></svg>
        {%- when 'bus' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7z"/><circle cx="6.5" cy="17.5" r="1.7"/><circle cx="16.5" cy="17.5" r="1.7"/></svg>
        {%- when 'klok' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
        {%- else -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 19 6v5.6c0 4.3-2.9 7.6-7 8.9-4.1-1.3-7-4.6-7-8.9V6z"/><path d="m8.8 12.2 2.2 2.2 4.2-4.4"/></svg>
      {%- endcase -%}
      {{ block.settings.tekst }}
    </span>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "WS7 · Zekerheid",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [ { "type": "checkbox", "id": "wit", "label": "Witte achtergrond", "default": false } ],
  "blocks": [
    { "type": "item", "name": "Zekerheid", "settings": [
      { "type": "select", "id": "icoon", "label": "Icoon", "default": "schild", "options": [
        { "value": "ster", "label": "Ster" }, { "value": "schild", "label": "Schild" }, { "value": "bus", "label": "Bus" }, { "value": "klok", "label": "Klok" } ] },
      { "type": "text", "id": "tekst", "label": "Tekst", "default": "100 dagen proberen" }
    ]}
  ],
  "presets": [ { "name": "WS7 · Zekerheid" } ]
}
{% endschema %}
