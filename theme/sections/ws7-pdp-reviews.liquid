{% comment %}
  Wellshave v7 · productpagina: reviews als schuifrij met de Trustpilot-score ernaast.
  De reviews zijn blokken. Een blok kan aan producten hangen ("Alleen bij"): leeg = bij
  elk product, anders alleen op die productpagina's. Zo staat er geen tondeusereview
  op de pagina van een bodygroomer.
{% endcomment %}
{%- assign s = section.settings -%}
{%- assign n = 0 -%}
{%- capture kaarten -%}
  {%- for block in section.blocks -%}
    {%- assign alleen = block.settings.alleen_bij -%}
    {%- if alleen != blank -%}
      {%- assign hier = false -%}
      {%- for ap in alleen -%}{%- if ap.id == product.id -%}{%- assign hier = true -%}{%- endif -%}{%- endfor -%}
      {%- unless hier -%}{%- continue -%}{%- endunless -%}
    {%- endif -%}
    {%- assign n = n | plus: 1 -%}
    <article class="ws7p-rv" {{ block.shopify_attributes }}>
      <span class="ws7p-st" role="img" aria-label="{{ block.settings.sterren }} / 5">
        {%- for i in (1..5) -%}<i{% if i > block.settings.sterren %} class="is-leeg"{% endif %}><svg viewBox="0 0 24 24"><path d="M12 2.8l2.7 5.9 6.4.7-4.8 4.4 1.3 6.4L12 17l-5.6 3.2 1.3-6.4-4.8-4.4 6.4-.7z"/></svg></i>{%- endfor -%}
      </span>
      {%- if block.settings.titel != blank -%}<h3>{{ block.settings.titel }}</h3>{%- endif -%}
      <p>{{ block.settings.tekst }}</p>
      <footer>
        <i aria-hidden="true">{{ block.settings.naam | slice: 0 | upcase }}</i>
        <span><b>{{ block.settings.naam }}</b>{{ block.settings.regel | default: s.koper }}</span>
      </footer>
    </article>
  {%- endfor -%}
{%- endcapture -%}
{%- if n > 0 -%}
  {{ 'ws7.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ws7.js' | asset_url }}" defer></script>
  <div class="ws7 ws7p">
    <div class="ws7p-rail ws7p-sec">
      <div class="ws7p-rv-kop">
        <div>
          {%- if s.oog != blank -%}<span class="ws7-oog">{{ s.oog }}</span>{%- endif -%}
          {% render 'ws7-kop', kop: s.kop, goud: s.kop_goud %}
        </div>
        {%- if s.cijfer != blank -%}
          <a class="ws7p-rv-score" href="{{ s.link | default: '#' }}" target="_blank" rel="noopener nofollow">
            <b>{{ s.cijfer }}</b>
            <span>
              <span class="ws7p-st ws7p-st--tp" aria-hidden="true">{%- for i in (1..5) -%}<i{% if i == 5 and s.half %} class="is-half"{% endif %}><svg viewBox="0 0 24 24"><path d="M12 2.8l2.7 5.9 6.4.7-4.8 4.4 1.3 6.4L12 17l-5.6 3.2 1.3-6.4-4.8-4.4 6.4-.7z"/></svg></i>{%- endfor -%}</span>
              <span>{{ s.score_regel }}</span>
            </span>
          </a>
        {%- endif -%}
      </div>
      <div class="ws7-schuif">
        <div class="ws7-rij">{{ kaarten }}</div>
        {% render 'ws7-voortgang' %}
      </div>
      {%- if s.link_label != blank -%}<div class="ws7-midden"><a class="ws7-link" href="{{ s.link | default: '#' }}" target="_blank" rel="noopener nofollow">{{ s.link_label }}{% render 'ws7-pijl' %}</a></div>{%- endif -%}
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "WS7 · PDP reviews",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "oog", "label": "Bovenregel", "default": "Reviews" },
    { "type": "text", "id": "kop", "label": "Kop", "default": "4,5 uit 5." },
    { "type": "text", "id": "kop_goud", "label": "Kop, regel in goud", "default": "Van 1.000+ klanten." },
    { "type": "text", "id": "cijfer", "label": "Cijfer in de scorekaart", "default": "4,5" },
    { "type": "checkbox", "id": "half", "label": "Laatste ster half", "default": true },
    { "type": "text", "id": "score_regel", "label": "Regel in de scorekaart", "default": "Uitstekend op Trustpilot" },
    { "type": "text", "id": "koper", "label": "Regel onder de naam", "default": "Geverifieerde koper" },
    { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Lees alle reviews op Trustpilot" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "text", "id": "titel", "label": "Titel" },
      { "type": "textarea", "id": "tekst", "label": "Tekst" },
      { "type": "text", "id": "naam", "label": "Naam" },
      { "type": "text", "id": "regel", "label": "Regel onder de naam", "info": "Leeg = de regel uit de sectie, bijvoorbeeld Geverifieerde koper." },
      { "type": "range", "id": "sterren", "label": "Sterren", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "product_list", "id": "alleen_bij", "label": "Alleen bij", "info": "Leeg = op elke productpagina." }
    ]}
  ],
  "presets": [ { "name": "WS7 · PDP reviews" } ]
}
{% endschema %}
