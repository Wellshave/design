{% comment %}
  Wellshave — blok 5, de zonekiezer.
  Ontwerp en onderbouwing: audits/blok-05-waardeproposities.template.html
  Elke zone is een blok. Naam, prijs en link komen uit het gekozen product;
  het aantal apparaten en de vanaf-prijs uit de gekozen collectie.
  De positie van de stip op de foto stel je per zone in.
{% endcomment %}

{{ 'ws-zonekiezer.css' | asset_url | stylesheet_tag }}

{% render 'indent-settings', section: section %}

<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
