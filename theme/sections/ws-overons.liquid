{% comment %}
  Wellshave — Over ons.
  Zelfde ontwerptaal als de homepage: donker #0B0B0A met gouden gloed, licht
  #F7F2E9 in een gouden kader, accent in <b> in plaats van een tweede kopregel.
  Opmaak: assets/ws-overons.css. Sjabloon: templates/page.ws-overons.json.

  Drie dingen die uit blok 12 van de homepage zijn overgenomen:
  * boven- en ondermarge via de sectie-instellingen, niet via de CSS;
  * mobiel is een echte media query op 749px, geen .ws-m-klasse;
  * elke klasse begint met ws- zodat thema-CSS er niet doorheen lekt.

  Het aantal kolommen gaat via --ws-kol en niet via een inline stijl: een
  inline stijl wint van elke media query, ook van de mobiele.
{% endcomment %}

{{ 'ws-overons.css' | asset_url | stylesheet_tag }}

{% render 'indent-settings', section: section %}

<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <symbol id="ws-ov-chk" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7.8 12.3l2.9 2.9 5.5-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="ws-ov-krs" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 9l6 6M15 9l-6 6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
  <symbol id="ws-ov-tel" viewBox="0 0 24 24"><path d="M17 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M19 8v6M22 11h-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="7" r="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/></symbol>
  <symbol id="ws-ov-v1" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 7.6v5.2M12 16.1v.1" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
  <symbol id="ws-ov-v2" viewBox="0 0 24 24"><path d="M3.4 7.2h13l4.2 4.8-4.2 4.8h-13z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.2 12h6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
  <symbol id="ws-ov-v3" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="1.1" fill="currentColor"/></symbol>
</svg>

<div class="ws-ov">

  {%- comment -%} ── 1. hero ── {%- endcomment -%}
  <header class="ws-ov__hero" {% if section.settings.hero_hoogte > 0 %}style="--ws-ov-hero-h:{{ section.settings.hero_hoogte }}px"{% endif %}>
    <div class="ws-ov__media">
      {%- if section.settings.foto != blank -%}
        {{ section.settings.foto | image_url: width: 1600 | image_tag: class: 'ws-ov__foto', alt: section.settings.foto_alt, loading: 'eager' }}
      {%- endif -%}
      <div class="ws-ov__scrim"></div>
    </div>
    {%- if section.settings.merk != blank -%}
      {{ section.settings.merk | image_url: width: 840 | image_tag: class: 'ws-ov__merk', alt: '' }}
    {%- endif -%}
    <div class="ws-ov__streep"></div>

    <div class="ws-ov__heroin"><div class="ws-ov__heroblok">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="ws-ov__eyebrow">{{ section.settings.hero_eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.hero_kop != blank -%}
        <h1 class="ws-ov__h1">{{ section.settings.hero_kop | replace: '|br|', '<br>' }}</h1>
      {%- endif -%}
      {%- if section.settings.hero_lead != blank -%}
        <p class="ws-ov__lead">{{ section.settings.hero_lead }}</p>
      {%- endif -%}
      {%- if section.settings.tel_getal != blank -%}
        <p class="ws-ov__teller">
          <svg><use href="#ws-ov-tel"/></svg>
          <span><b>{{ section.settings.tel_getal }}</b><em>{{ section.settings.tel_label }}</em></span>
        </p>
      {%- endif -%}
    </div></div>
  </header>

  {%- comment -%} ── 2. de drie vragen ── {%- endcomment -%}
  <section class="ws-ov__vragen"><div class="ws-ov__rand">
    {%- if section.settings.merk != blank -%}
      {{ section.settings.merk | image_url: width: 420 | image_tag: class: 'ws-ov__randmerk', alt: '' }}
    {%- endif -%}
    <div class="ws-ov__randin">

      <div class="ws-ov__kop">
        {%- if section.settings.vr_eyebrow != blank -%}
          <p class="ws-ov__eyebrow">{{ section.settings.vr_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.vr_kop != blank -%}
          <h2 class="ws-ov__h2">{{ section.settings.vr_kop | replace: '|br|', '<br>' }}</h2>
        {%- endif -%}
        {%- if section.settings.vr_sub != blank -%}
          <p class="ws-ov__sub">{{ section.settings.vr_sub }}</p>
        {%- endif -%}
      </div>

      {%- assign vragen = section.blocks | where: 'type', 'vraag' -%}
      {%- if vragen.size > 0 -%}
        <div class="ws-ov__drie" style="--ws-kol:{{ vragen.size | at_most: 3 | at_least: 1 }}">
          {%- for block in vragen -%}
            <article class="ws-ov__vraag" {{ block.shopify_attributes }}>
              <span class="ws-ov__zegel"><svg><use href="#ws-ov-{{ block.settings.icoon | default: 'v1' }}"/></svg></span>
              {%- if block.settings.nr != blank -%}
                <p class="ws-ov__vraagnr">{{ block.settings.nr }}</p>
              {%- endif -%}
              {%- if block.settings.kop != blank -%}
                <h3 class="ws-ov__vraagh">{{ block.settings.kop }}</h3>
              {%- endif -%}
              {%- if block.settings.tekst != blank -%}
                <p class="ws-ov__vraagt">{{ block.settings.tekst }}</p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.vr_slot != blank -%}
        <p class="ws-ov__vraagslot"><svg><use href="#ws-ov-chk"/></svg><span>{{ section.settings.vr_slot }}</span></p>
      {%- endif -%}

    </div>
  </div></section>

  {%- comment -%} ── 3. de werkwijze ── {%- endcomment -%}
  <section class="ws-ov__werk"><div class="ws-ov__werkin">

    <div class="ws-ov__werkkop">
      {%- if section.settings.wk_eyebrow != blank -%}
        <p class="ws-ov__eyebrow">{{ section.settings.wk_eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.wk_kop != blank -%}
        <h2 class="ws-ov__h2--dark">{{ section.settings.wk_kop | replace: '|br|', '<br>' }}</h2>
      {%- endif -%}
      {%- if section.settings.wk_sub != blank -%}
        <p class="ws-ov__sub--dark">{{ section.settings.wk_sub }}</p>
      {%- endif -%}
    </div>

    {%- assign stappen = section.blocks | where: 'type', 'stap' -%}
    {%- if stappen.size > 0 -%}
      <div class="ws-ov__stappen" style="--ws-kol:{{ stappen.size | at_most: 3 | at_least: 1 }}">
        {%- for block in stappen -%}
          <div class="ws-ov__stap" {{ block.shopify_attributes }}>
            <p class="ws-ov__cijfer">{{ block.settings.cijfer }}</p>
            {%- if block.settings.label != blank -%}
              <p class="ws-ov__staplabel">{{ block.settings.label }}</p>
            {%- endif -%}
            {%- if block.settings.tekst != blank -%}
              <p class="ws-ov__staptekst">{{ block.settings.tekst }}</p>
            {%- endif -%}
            {%- if block.settings.citaat != blank -%}
              <blockquote class="ws-ov__stem">{{ block.settings.citaat }}
                {%- if block.settings.citaat_bron != blank -%}<b>{{ block.settings.citaat_bron }}</b>{%- endif -%}
              </blockquote>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div></section>

  {%- comment -%} ── 4. wat wij wel en niet beloven ── {%- endcomment -%}
  <section class="ws-ov__belofte"><div class="ws-ov__duo" style="--ws-kol:2">

    <div class="ws-ov__paneel">
      {%- if section.settings.merk != blank -%}
        {{ section.settings.merk | image_url: width: 420 | image_tag: class: 'ws-ov__paneelmerk', alt: '' }}
      {%- endif -%}
      {%- if section.settings.wel_eyebrow != blank -%}
        <p class="ws-ov__paneelkop">{{ section.settings.wel_eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.wel_kop != blank -%}
        <h3 class="ws-ov__paneelh">{{ section.settings.wel_kop | replace: '|br|', '<br>' }}</h3>
      {%- endif -%}
      <ul class="ws-ov__lijst">
        {%- for i in (1..4) -%}
          {%- assign sleutel = 'wel_punt_' | append: i -%}
          {%- assign punt = section.settings[sleutel] -%}
          {%- if punt != blank -%}
            <li><svg class="ws-ov__vink"><use href="#ws-ov-chk"/></svg><span>{{ punt }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.team_titel != blank -%}
        <div class="ws-ov__team">
          {%- if section.settings.team_1 != blank or section.settings.team_2 != blank or section.settings.team_3 != blank -%}
            <span class="ws-ov__koppen">
              {%- for i in (1..3) -%}
                {%- assign sleutel = 'team_' | append: i -%}
                {%- assign kop = section.settings[sleutel] -%}
                {%- if kop != blank -%}<i>{{ kop | image_url: width: 120 | image_tag: alt: '' }}</i>{%- endif -%}
              {%- endfor -%}
            </span>
          {%- endif -%}
          <span><b>{{ section.settings.team_titel }}</b><em>{{ section.settings.team_tekst }}</em></span>
        </div>
      {%- endif -%}
    </div>

    <div class="ws-ov__paneel ws-ov__paneel--licht">
      {%- if section.settings.niet_eyebrow != blank -%}
        <p class="ws-ov__paneelkop">{{ section.settings.niet_eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.niet_kop != blank -%}
        <h3 class="ws-ov__paneelh">{{ section.settings.niet_kop | replace: '|br|', '<br>' }}</h3>
      {%- endif -%}
      <ul class="ws-ov__lijst">
        {%- for i in (1..4) -%}
          {%- assign sleutel = 'niet_punt_' | append: i -%}
          {%- assign punt = section.settings[sleutel] -%}
          {%- if punt != blank -%}
            <li><svg class="ws-ov__kruis"><use href="#ws-ov-krs"/></svg><span>{{ punt }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

  </div></section>

  {%- comment -%} ── 5. afsluiter ── {%- endcomment -%}
  <section class="ws-ov__af"><div class="ws-ov__afin">
    {%- if section.settings.af_eyebrow != blank -%}
      <p class="ws-ov__eyebrow">{{ section.settings.af_eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.af_kop != blank -%}
      <h2 class="ws-ov__h2--dark">{{ section.settings.af_kop | replace: '|br|', '<br>' }}</h2>
    {%- endif -%}
    {%- if section.settings.af_sub != blank -%}
      <p class="ws-ov__sub--dark">{{ section.settings.af_sub }}</p>
    {%- endif -%}
    <div class="ws-ov__knoppen">
      {%- if section.settings.cta1_label != blank -%}
        <a class="ws-ov__cta" href="{{ section.settings.cta1_link | default: '/collections/all' }}">
          {{ section.settings.cta1_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a class="ws-ov__cta ws-ov__cta--rand" href="{{ section.settings.cta2_link | default: '/pages/quiz' }}">{{ section.settings.cta2_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.af_reden != blank -%}
      <p class="ws-ov__afreden">{{ section.settings.af_reden }}</p>
    {%- endif -%}
  </div></section>

</div>

{% schema %}
{
  "name": "WS · Over ons",
  "tag": "section",
  "max_blocks": 6,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "1 · Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Bovenregel", "default": "Over Wellshave" },
    { "type": "inline_richtext", "id": "hero_kop", "label": "Kop (vet = goud, |br| = regeleinde)", "default": "Jij bent niet het probleem.|br|<b>Je gereedschap is dat wel.</b>" },
    { "type": "textarea", "id": "hero_lead", "label": "Lead", "default": "Wij beginnen nooit bij het apparaat. We beginnen bij de plek waar het bij jou misgaat, en werken van daaruit terug naar wat er in je hand moet liggen." },
    { "type": "image_picker", "id": "foto", "label": "Herofoto" },
    { "type": "text", "id": "foto_alt", "label": "Alt-tekst bij de herofoto" },
    { "type": "image_picker", "id": "merk", "label": "Monogram (watermerk)" },
    { "type": "range", "id": "hero_hoogte", "label": "Minimale hoogte hero (desktop)", "min": 0, "max": 760, "step": 20, "unit": "px", "default": 520 },
    { "type": "text", "id": "tel_getal", "label": "Teller — getal", "default": "180.000+" },
    { "type": "text", "id": "tel_label", "label": "Teller — label", "default": "bestellingen sinds 2021" },

    { "type": "header", "content": "2 · De drie vragen" },
    { "type": "text", "id": "vr_eyebrow", "label": "Bovenregel", "default": "Hoe wij ontwerpen" },
    { "type": "inline_richtext", "id": "vr_kop", "label": "Kop (vet = brons)", "default": "Voordat er iets getekend wordt, <b>stellen we drie vragen over jou.</b>" },
    { "type": "textarea", "id": "vr_sub", "label": "Subkop", "default": "Niet over de techniek, niet over de markt. Over de man die het apparaat straks in zijn hand houdt. Komt er op een van de drie geen scherp antwoord, dan gaat het product niet in productie." },
    { "type": "inline_richtext", "id": "vr_slot", "label": "Slotregel", "default": "Elk apparaat in de winkel is <b>langs deze drie vragen gekomen</b> voordat het gemaakt werd." },

    { "type": "header", "content": "3 · De werkwijze" },
    { "type": "text", "id": "wk_eyebrow", "label": "Bovenregel", "default": "Van jouw probleem naar jouw resultaat" },
    { "type": "inline_richtext", "id": "wk_kop", "label": "Kop (vet = goud)", "default": "Wat de vorige klant miste, <b>zit in jouw apparaat.</b>" },
    { "type": "textarea", "id": "wk_sub", "label": "Subkop", "default": "Met z'n zessen bouwen en testen we alles zelf. Elke stap hieronder begon bij een klant die iets terugstuurde, miste of beter wilde." },

    { "type": "header", "content": "4 · Wat wij wel beloven" },
    { "type": "text", "id": "wel_eyebrow", "label": "Bovenregel", "default": "Wat wij wel beloven" },
    { "type": "inline_richtext", "id": "wel_kop", "label": "Kop (vet = goud)", "default": "Jij hoeft alleen te proberen.|br|<b>Het risico ligt bij ons.</b>" },
    { "type": "text", "id": "wel_punt_1", "label": "Punt 1", "default": "100 dagen thuis proberen. Bevalt het niet, dan krijg je je geld terug." },
    { "type": "text", "id": "wel_punt_2", "label": "Punt 2", "default": "2 jaar garantie op elk apparaat." },
    { "type": "text", "id": "wel_punt_3", "label": "Punt 3", "default": "Gratis verzending vanaf €30, voor 23:59 besteld is morgen in huis." },
    { "type": "text", "id": "wel_punt_4", "label": "Punt 4", "default": "Een mens die je mail leest, geen chatbot." },
    { "type": "text", "id": "team_titel", "label": "Team — titel", "default": "Klantenservice en magazijn" },
    { "type": "text", "id": "team_tekst", "label": "Team — tekst", "default": "Zitten in hetzelfde pand in Helmond." },
    { "type": "image_picker", "id": "team_1", "label": "Teamfoto 1" },
    { "type": "image_picker", "id": "team_2", "label": "Teamfoto 2" },
    { "type": "image_picker", "id": "team_3", "label": "Teamfoto 3" },

    { "type": "header", "content": "4 · Wat wij niet beloven" },
    { "type": "text", "id": "niet_eyebrow", "label": "Bovenregel", "default": "Wat wij niet beloven" },
    { "type": "inline_richtext", "id": "niet_kop", "label": "Kop (vet = brons)", "default": "Liever eerlijk vooraf <b>dan een teleurstelling achteraf.</b>" },
    { "type": "text", "id": "niet_punt_1", "label": "Punt 1", "default": "Kaal als glas. De meeste mannen willen dat niet, en wij doen niet alsof." },
    { "type": "text", "id": "niet_punt_2", "label": "Punt 2", "default": "Dat het bij iedereen identiek uitpakt. Huid en haargroei verschillen." },
    { "type": "text", "id": "niet_punt_3", "label": "Punt 3", "default": "Dat een apparaat je huid verandert. Het verandert hoe je hem behandelt." },
    { "type": "text", "id": "niet_punt_4", "label": "Punt 4", "default": "Het goedkoopste van het schap. Wel de eerlijkste prijs voor wat je krijgt." },

    { "type": "header", "content": "5 · Afsluiter" },
    { "type": "text", "id": "af_eyebrow", "label": "Bovenregel", "default": "Begin bij jezelf" },
    { "type": "inline_richtext", "id": "af_kop", "label": "Kop (vet = goud)", "default": "Jij weet het beste <b>waar het misgaat.</b>" },
    { "type": "textarea", "id": "af_sub", "label": "Subkop", "default": "Kies het apparaat voor de plek waar jij iets weg wilt hebben. Doet het niet wat wij hier beweren, dan stuur je het binnen honderd dagen terug." },
    { "type": "text", "id": "cta1_label", "label": "Knop 1 — tekst", "default": "Kies jouw apparaat" },
    { "type": "url", "id": "cta1_link", "label": "Knop 1 — link" },
    { "type": "text", "id": "cta2_label", "label": "Knop 2 — tekst", "default": "Weet je het niet? Doe de quiz" },
    { "type": "url", "id": "cta2_link", "label": "Knop 2 — link (leeg = /pages/quiz)" },
    { "type": "inline_richtext", "id": "af_reden", "label": "Redenregel", "default": "100 dagen proberen · 2 jaar garantie · <b>gratis verzending vanaf €30</b>" },

    { "type": "header", "content": "Indent settings" },
    { "type": "range", "id": "desk_indent_top", "label": "Indent top (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "desk_indent_bottom", "label": "Indent bottom (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mob_indent_top", "label": "Indent top (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "mob_indent_bottom", "label": "Indent bottom (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "vraag",
      "name": "Vraag",
      "settings": [
        { "type": "select", "id": "icoon", "label": "Icoon", "options": [
          { "value": "v1", "label": "Uitroepteken — het probleem" },
          { "value": "v2", "label": "Pijl — de oplossing" },
          { "value": "v3", "label": "Roos — het doel" }
        ], "default": "v1" },
        { "type": "text", "id": "nr", "label": "Nummer" },
        { "type": "text", "id": "kop", "label": "Vraag" },
        { "type": "textarea", "id": "tekst", "label": "Tekst" }
      ]
    },
    {
      "type": "stap",
      "name": "Stap",
      "settings": [
        { "type": "text", "id": "cijfer", "label": "Cijfer" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "textarea", "id": "tekst", "label": "Tekst" },
        { "type": "textarea", "id": "citaat", "label": "Citaat van een klant (optioneel)" },
        { "type": "text", "id": "citaat_bron", "label": "Citaat — bron" }
      ]
    }
  ],
  "presets": [ { "name": "WS · Over ons" } ]
}
{% endschema %}
