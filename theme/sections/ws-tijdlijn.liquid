{% comment %}
  Wellshave — blok 4, de upgradetijdlijn.
  Ontwerp en onderbouwing: audits/blok-04-mechanisme.template.html
  Elke upgrade is een blok, dus je kunt er zelf bij zetten wat er nieuw komt.
{% endcomment %}

{{ 'ws-tijdlijn.css' | asset_url | stylesheet_tag }}

{% render 'indent-settings', section: section %}

<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <symbol id="ws-mc-arw" viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="ws-mc-chk" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7.8 12.3l2.9 2.9 5.5-6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="ws-mc-star" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01z"/></symbol>
  <symbol id="ws-mc-people" viewBox="0 0 24 24"><circle cx="9.2" cy="8.4" r="3.4" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M2.9 19.4c.5-3.2 3.2-5.2 6.3-5.2s5.8 2 6.3 5.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M15.8 5.4a3.4 3.4 0 0 1 0 6.6M17.4 14.6c2.1.5 3.5 2.2 3.8 4.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></symbol>
  <symbol id="ws-mc-shield" viewBox="0 0 24 24"><path d="M12 2.6l7.2 2.8v6.1c0 4.4-3 8.4-7.2 9.9-4.2-1.5-7.2-5.5-7.2-9.9V5.4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8.7 12.1l2.3 2.3 4.3-4.6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</svg>

{%- assign kaarten = section.blocks | where: 'type', 'upgrade' -%}
{%- assign feiten = section.blocks | where: 'type', 'feit' -%}

<div class="ws-mc" data-ws-tijdlijn>
  <div class="ws-mc__in">
    <div class="ws-mc__top">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="ws-mc__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.kop != blank -%}
          <h2 class="ws-mc__h2">{{ section.settings.kop | replace: '|br|', '<br>' }}</h2>
        {%- endif -%}
      </div>
      <div class="ws-mc__right">
        {%- if section.settings.note != blank -%}
          <p class="ws-mc__note">{{ section.settings.note }}</p>
        {%- endif -%}
        {%- if section.settings.flow_van != blank -%}
          <p class="ws-mc__flow">{{ section.settings.flow_van }}
            <svg viewBox="0 0 22 12" fill="none"><path d="M0 6h18M14 1.5 19.5 6 14 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {{ section.settings.flow_naar }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="ws-mc__rail">
      <span class="ws-mc__raillijn"></span>
      <div class="ws-mc__dots">
        {%- for block in kaarten -%}
          <span class="ws-mc__dot"><i></i>{{ block.settings.datum }}</span>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="ws-mc__wrap">
    <div class="ws-mc__track">
      {%- for block in kaarten -%}
        <article class="ws-mc__kaart" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}
            <span class="ws-mc__badge">{{ block.settings.badge }}</span>
          {%- endif -%}
          <div class="ws-mc__body">
            {%- if block.settings.groep != blank -%}
              <p class="ws-mc__lijn">{{ block.settings.groep }}</p>
            {%- endif -%}
            <div class="ws-mc__paar">
              <span class="ws-mc__stap">
                <span class="ws-mc__shot">
                  {%- if block.settings.foto_oud != blank -%}
                    {{ block.settings.foto_oud | image_url: width: 500 | image_tag: alt: '' }}
                  {%- endif -%}
                </span>
                <span class="ws-mc__jaar">{{ block.settings.jaar_oud }}</span>
              </span>
              <span class="ws-mc__pijl"><svg><use href="#ws-mc-arw"/></svg></span>
              <span class="ws-mc__stap">
                <span class="ws-mc__shot">
                  {%- if block.settings.foto_nieuw != blank -%}
                    {{ block.settings.foto_nieuw | image_url: width: 500 | image_tag: alt: block.settings.naam }}
                  {%- endif -%}
                </span>
                <span class="ws-mc__jaar">{{ block.settings.datum }}</span>
              </span>
            </div>
            <h3 class="ws-mc__naam">{{ block.settings.naam }}</h3>
            <p class="ws-mc__datum">{{ block.settings.datum }}</p>
            {%- if block.settings.tag != blank -%}
              <span class="ws-mc__tag"><svg><use href="#ws-mc-chk"/></svg>{{ block.settings.tag }}</span>
            {%- endif -%}
            {%- if block.settings.wat != blank -%}
              <p class="ws-mc__wat"><svg><use href="#ws-mc-chk"/></svg><span>{{ block.settings.wat }}</span></p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>

  <div class="ws-mc__in">
    <div class="ws-mc__ctrl">
      <button class="ws-mc__nav is-terug" type="button" aria-label="Vorige upgrade"><svg><use href="#ws-mc-arw"/></svg></button>
      <span class="ws-mc__teller">
        <b><em>01</em> / {{ kaarten.size | prepend: '0' | slice: -2, 2 }}</b>
        <span class="ws-mc__balk"><i style="width:0%"></i></span>
      </span>
      <button class="ws-mc__nav is-verder" type="button" aria-label="Volgende upgrade"><svg><use href="#ws-mc-arw"/></svg></button>
    </div>
  </div>

  {%- if feiten.size > 0 -%}
    <div class="ws-mc__bottom"><div class="ws-mc__facts">
      {%- for block in feiten -%}
        <p class="ws-mc__fact" {{ block.shopify_attributes }}>
          <span class="ws-mc__ico"><svg><use href="#ws-mc-{{ block.settings.icoon }}"/></svg></span>
          <span class="ws-mc__txt">
            <b>{{ block.settings.waarde }}{% if block.settings.eenheid != blank %} <em>{{ block.settings.eenheid }}</em>{% endif %}</b>
            <span>{{ block.settings.label }}</span>
          </span>
        </p>
      {%- endfor -%}
    </div></div>
  {%- endif -%}
</div>

<script>
  // De upgradetijdlijn. Elke sectie krijgt zijn eigen instantie.
  (function () {
    document.querySelectorAll('[data-ws-tijdlijn]').forEach(function (sec) {
      if (sec.dataset.wsKlaar) return;
      sec.dataset.wsKlaar = '1';
      var wrap = sec.querySelector('.ws-mc__wrap');
      var track = sec.querySelector('.ws-mc__track');
      var kaart = [].slice.call(sec.querySelectorAll('.ws-mc__kaart'));
      var punt = [].slice.call(sec.querySelectorAll('.ws-mc__dot'));
      var teller = sec.querySelector('.ws-mc__teller em');
      var balk = sec.querySelector('.ws-mc__balk i');
      if (!track || !kaart.length) return;

      var traag = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var DUUR = 5500;
      var i = Math.min(2, kaart.length - 1), start = Date.now(), pauze = false, rest = 0;

      function plaats() {
        var k = kaart[i];
        var x = wrap.clientWidth / 2 - (k.offsetLeft + k.offsetWidth / 2);
        track.style.transform = 'translateX(' + Math.round(x) + 'px)';
        kaart.forEach(function (c, n) { c.classList.toggle('is-aan', n === i); });
        punt.forEach(function (p, n) { p.classList.toggle('is-aan', n === i); });
        if (teller) teller.textContent = ('0' + (i + 1)).slice(-2);
      }
      function ga(n) { i = (n + kaart.length) % kaart.length; start = Date.now(); rest = 0; plaats(); }

      sec.querySelector('.ws-mc__nav.is-verder').addEventListener('click', function () { ga(i + 1); });
      sec.querySelector('.ws-mc__nav.is-terug').addEventListener('click', function () { ga(i - 1); });
      punt.forEach(function (p, n) {
        p.setAttribute('role', 'button'); p.tabIndex = 0;
        p.addEventListener('click', function () { ga(n); });
        p.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); ga(n); }
        });
      });

      // stilstaan zolang iemand kijkt of leest
      ['mouseenter', 'focusin'].forEach(function (e) {
        sec.addEventListener(e, function () { if (!pauze) { pauze = true; rest = Date.now() - start; } });
      });
      ['mouseleave', 'focusout'].forEach(function (e) {
        sec.addEventListener(e, function () { if (pauze) { pauze = false; start = Date.now() - rest; } });
      });

      function tik() {
        if (!traag && !pauze) {
          var v = Date.now() - start;
          if (v >= DUUR) ga(i + 1);
          else if (balk) balk.style.width = (v / DUUR * 100).toFixed(1) + '%';
        } else if (balk && pauze) balk.style.width = (rest / DUUR * 100).toFixed(1) + '%';
      }
      if (!traag) setInterval(tik, 90);

      addEventListener('resize', plaats);
      if (document.fonts) document.fonts.ready.then(plaats);
      addEventListener('load', plaats);
      plaats();
    });
  })();
</script>

{% schema %}
{
  "name": "WS · Upgradetijdlijn",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Hoe we bouwen" },
    { "type": "inline_richtext", "id": "kop", "label": "Kop (vet = goud, eigen regel)", "default": "We zijn nooit klaar met een apparaat. <b>Ook niet als hij goed verkoopt.</b>" },
    { "type": "textarea", "id": "note", "label": "Tekst rechts", "default": "Met z'n zessen bouwen, testen en verbeteren we alles zelf. Elke upgrade begint bij wat jij terugstuurt, mist of beter wilt." },
    { "type": "text", "id": "flow_van", "label": "Pijlregel links", "default": "Van klantvraag" },
    { "type": "text", "id": "flow_naar", "label": "Pijlregel rechts", "default": "productverbetering" },
    { "type": "header", "content": "Indent settings" },
    { "type": "range", "id": "desk_indent_top", "label": "Indent top (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "desk_indent_bottom", "label": "Indent bottom (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mob_indent_top", "label": "Indent top (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "mob_indent_bottom", "label": "Indent bottom (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "upgrade",
      "name": "Upgrade",
      "settings": [
        { "type": "text", "id": "groep", "label": "Productgroep" },
        { "type": "image_picker", "id": "foto_oud", "label": "Foto oude versie" },
        { "type": "text", "id": "jaar_oud", "label": "Jaar oude versie" },
        { "type": "image_picker", "id": "foto_nieuw", "label": "Foto nieuwe versie" },
        { "type": "text", "id": "naam", "label": "Naam nieuwe versie" },
        { "type": "text", "id": "datum", "label": "Datum", "info": "Staat ook op de tijdlijn erboven." },
        { "type": "text", "id": "tag", "label": "Label", "info": "Bijvoorbeeld: Op verzoek van klanten." },
        { "type": "textarea", "id": "wat", "label": "Wat er beter werd" },
        { "type": "text", "id": "badge", "label": "Badge boven de kaart" }
      ]
    },
    {
      "type": "feit",
      "name": "Cijfer",
      "settings": [
        { "type": "select", "id": "icoon", "label": "Icoon", "options": [ { "value": "star", "label": "Ster" }, { "value": "people", "label": "Mensen" }, { "value": "shield", "label": "Schild" } ], "default": "star" },
        { "type": "text", "id": "waarde", "label": "Getal" },
        { "type": "text", "id": "eenheid", "label": "Eenheid" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [ { "name": "WS · Upgradetijdlijn" } ]
}
{% endschema %}
