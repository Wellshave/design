{% comment %}
  Wellshave — productpagina, blok 01: alles boven de vouw.
  Ontwerp: rapporten/blokken/01-above-the-fold-v2-donker.html
  Volgorde en onderbouwing: rapporten/volgorde.html, rapporten/pdp-plan.html

  De wortel is <main-product> zodat de bestaande base.js het formulier,
  de variantwissel en de winkelwagenlade oppakt. De id-voorvoegsels
  ProductForm-, ProductSubmit-, ProductOptions-, ProductPrice- en
  ProductGallery- zijn daarvoor verplicht — niet hernoemen.
{% endcomment %}

{{ 'ws-pdp-koopvak.css' | asset_url | stylesheet_tag }}
{% render 'indent-settings', section: section %}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign s = section.settings
  assign mf = product.metafields.custom

  assign belofte = mf.hero_promise.value | default: mf.subtitle.value
  assign citaat = mf.buybox_quote.value | default: s.citaat
  assign citaat_wie = mf.buybox_quote_author.value | default: s.citaat_wie

  assign campagne = ''
  if mf.limited_offer.value != blank
    assign campagne = mf.limited_offer.value.product_title
  endif
  assign campagne = campagne | default: s.campagne

  assign korting = 0
  if v.compare_at_price > v.price
    assign verschil = v.compare_at_price | minus: v.price
    assign korting = verschil | times: 100.0 | divided_by: v.compare_at_price | round
  endif
-%}

<main-product class="ws-pdp" data-section="{{ section.id }}" data-template="{{ template.name }}">
  <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
    <symbol id="ws-pdp-ster-{{ section.id }}" viewBox="0 0 24 24"><path d="M12 2.6l2.9 6.2 6.6.9-4.8 4.6 1.2 6.6L12 17.8 6.1 20.9l1.2-6.6L2.5 9.7l6.6-.9z"/></symbol>
    <symbol id="ws-pdp-vink-{{ section.id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 12.4l4.2 4.2 8.8-9.2"/></symbol>
    <symbol id="ws-pdp-ok-{{ section.id }}" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#2E7CF6"/><path d="M7.6 12.3l3 3 5.8-6.2" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="ws-pdp-tag-{{ section.id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 12.9l-7.7 7.7a1.9 1.9 0 0 1-2.7 0l-7-7A1.9 1.9 0 0 1 2.6 12V4.4a1.8 1.8 0 0 1 1.8-1.8H12c.5 0 1 .2 1.3.6l7.3 7.3a1.9 1.9 0 0 1 0 2.4z"/><circle cx="7.6" cy="7.6" r="1.3"/></symbol>
    <symbol id="ws-pdp-gift-{{ section.id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3.6 11.6h16.8v8.8H3.6z"/><path d="M2.4 7.6h19.2v4H2.4zM12 7.6v12.8"/><path d="M12 7.6S10.7 3.2 8.4 3.2a2.2 2.2 0 0 0 0 4.4zM12 7.6s1.3-4.4 3.6-4.4a2.2 2.2 0 0 1 0 4.4z"/></symbol>
    <symbol id="ws-pdp-slot-{{ section.id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4.2" y="10.4" width="15.6" height="10.4" rx="2.2"/><path d="M8 10.4V7.6a4 4 0 0 1 8 0v2.8"/></symbol>
    <symbol id="ws-pdp-mensen-{{ section.id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9.2" cy="8.4" r="3.4"/><path d="M2.9 19.4c.5-3.2 3.2-5.2 6.3-5.2s5.8 2 6.3 5.2"/><path d="M15.8 5.4a3.4 3.4 0 0 1 0 6.6M17.4 14.6c2.1.5 3.5 2.2 3.8 4.4"/></symbol>
    <symbol id="ws-pdp-vgl-{{ section.id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.4" y="8.6" width="6.2" height="12" rx="1.4" class="vgl-a"/><rect x="14.4" y="3.4" width="6.2" height="17.2" rx="1.4"/></symbol>
  </svg>

  <div class="ws-rail">
    <div class="ws-pdp-grid">

      {%- comment -%} ---------- links: het podium ---------- {%- endcomment -%}
      <div class="ws-stg">
        <span class="ws-glans"></span>
        {%- if s.merk != blank -%}
          <img class="ws-ghost" src="{{ s.merk | image_url: width: 700 }}" alt="" loading="lazy" width="700" height="700">
        {%- endif -%}

        {%- if s.tag != blank -%}<span class="ws-tg">{{ s.tag }}</span>{%- endif -%}

        <ul class="ws-baan" id="ws-baan-{{ section.id }}">
          {%- for media in product.media limit: 8 -%}
            <li>
              {%- if forloop.first -%}
                {{ media.preview_image | image_url: width: 1200 | image_tag: class: 'ws-held', loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 749px) 92vw, 46vw', widths: '400,600,900,1200' }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 1200 | image_tag: class: 'ws-held', loading: 'lazy', sizes: '(max-width: 749px) 92vw, 46vw', widths: '400,600,900,1200' }}
              {%- endif -%}
            </li>
          {%- else -%}
            <li>{{ 'product-1' | placeholder_svg_tag: 'ws-held' }}</li>
          {%- endfor -%}
        </ul>

        {%- if product.media.size > 1 -%}
          <div class="ws-th" id="ws-th-{{ section.id }}">
            {%- for media in product.media limit: 5 -%}
              <figure{% if forloop.first %} class="ws-on"{% endif %}>
                <button type="button" class="ws-vk" data-ws-dia="{{ forloop.index0 }}"
                        aria-label="{{ media.alt | default: product.title | escape }}">
                  <img src="{{ media.preview_image | image_url: width: 300 }}" alt="{{ media.alt | escape }}"
                       loading="lazy" width="300" height="300">
                </button>
                {%- if media.alt != blank -%}<figcaption>{{ media.alt }}</figcaption>{%- endif -%}
              </figure>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- rechts: het koopvak ---------- {%- endcomment -%}
      <div class="ws-bb">
        <svg class="ws-strepen" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <defs><linearGradient id="ws-pdp-gd-{{ section.id }}" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#F5D18A" stop-opacity="0"/>
            <stop offset=".45" stop-color="#F5D18A" stop-opacity=".7"/>
            <stop offset="1" stop-color="#BC813E" stop-opacity="0"/>
          </linearGradient></defs>
          <path d="M92 6 C74 26 66 54 70 92" stroke="url(#ws-pdp-gd-{{ section.id }})" stroke-width=".5" fill="none"/>
          <path d="M99 14 C81 34 72 62 76 100" stroke="url(#ws-pdp-gd-{{ section.id }})" stroke-width=".3" fill="none"/>
        </svg>

        {%- if campagne != blank or korting > 0 -%}
          <span class="ws-pil">
            {%- if campagne != blank -%}<b class="ws-a">{{ campagne }}</b>{%- endif -%}
            {%- if korting > 0 -%}<b class="ws-z">{{ s.besparing_label | replace: '[korting]', korting }}</b>{%- endif -%}
          </span>
        {%- endif -%}

        {%- if s.tp_tonen -%}
          <div class="ws-tp">
            <span class="ws-st">
              {%- for i in (1..5) -%}<i><svg><use href="#ws-pdp-ster-{{ section.id }}"/></svg></i>{%- endfor -%}
            </span>
            {%- if s.tp_label != blank -%}<span class="ws-lb">{{ s.tp_label }}</span>{%- endif -%}
            {%- if s.tp_score != blank -%}<span class="ws-sc">&middot; {{ s.tp_score }}</span>{%- endif -%}
          </div>
        {%- endif -%}

        <div class="ws-h1">{{ product.title }}</div>
        {%- if belofte != blank -%}<div class="ws-sub">{{ belofte }}</div>{%- endif -%}

        {%- if citaat != blank -%}
          <div class="ws-rev">
            <div class="ws-kop">
              <span class="ws-lk">
                <span class="ws-st">
                  {%- for i in (1..5) -%}<i><svg><use href="#ws-pdp-ster-{{ section.id }}"/></svg></i>{%- endfor -%}
                </span>
                <b>{{ s.tp_bron }}</b>
              </span>
              <span class="ws-ok"><svg><use href="#ws-pdp-ok-{{ section.id }}"/></svg>{{ s.koper_label }}</span>
            </div>
            <q>{{ citaat }}</q>
            {%- if citaat_wie != blank -%}<span class="ws-wie"><b>{{ citaat_wie }}</b></span>{%- endif -%}
          </div>
        {%- endif -%}

        <div id="ProductPrice-{{ section.id }}">
          <div class="ws-prijs">
            <span class="ws-nu">{% render 'price-formated', price: v.price %}</span>
            {%- if v.compare_at_price > v.price -%}
              <span class="ws-was">{% render 'price-formated', price: v.compare_at_price %}</span>
              <span class="ws-off">&minus;{{ korting }}%</span>
            {%- endif -%}
          </div>
          {%- if v.compare_at_price > v.price -%}
            {%- assign bedrag = v.compare_at_price | minus: v.price -%}
            <span class="ws-besp">
              <svg><use href="#ws-pdp-tag-{{ section.id }}"/></svg>
              <span>{{ s.besparing_regel }} {% render 'price-formated', price: bedrag %}</span>
            </span>
          {%- endif -%}
        </div>

        {%- unless product.has_only_default_variant -%}
          <div id="ProductOptions-{{ section.id }}" class="ws-opties">
            {%- for option in product.options_with_values -%}
              <form class="ws-optie" data-option="{{ forloop.index }}">
                <b>{{ option.name }}</b>
                {%- for value in option.values -%}
                  <label for="{{ section.id }}-{{ option.name | handleize }}-{{ value | handleize }}">
                    <input type="radio" class="visually-hidden"
                           name="{{ option.name }}" value="{{ value }}"
                           id="{{ section.id }}-{{ option.name | handleize }}-{{ value | handleize }}"
                           {% if option.selected_value == value %}checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </form>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- assign usps = mf.product_usp.value -%}
        {%- if usps != blank -%}
          <ul class="ws-usp">
            {%- for regel in usps limit: 4 -%}
              {%- liquid
                assign r = regel | replace: '－', '—' | replace: ' - ', ' — '
                assign delen = r | split: '—'
                assign kop = delen[0] | strip
                assign rest = ''
                if delen.size > 1
                  assign rest = r | remove_first: delen[0] | remove_first: '—' | strip
                endif
              -%}
              <li>
                <span class="ws-vk"><svg><use href="#ws-pdp-vink-{{ section.id }}"/></svg></span>
                <span><b>{{ kop }}</b>{% if rest != blank %}<span>{{ rest }}</span>{% endif %}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.gift_titel != blank -%}
          <div class="ws-gift">
            <span class="ws-ic"><svg><use href="#ws-pdp-gift-{{ section.id }}"/></svg></span>
            <span>
              <b>{{ s.gift_titel }}</b>
              {%- if s.gift_regel != blank -%}<span>{{ s.gift_regel }}</span>{%- endif -%}
            </span>
          </div>
        {%- endif -%}

        <div class="ws-vorm">
          {%- assign form_id = 'ProductForm-' | append: section.id -%}
          {%- form 'product', product, id: form_id, class: 'ws-vorm-form', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ v.id }}">
            <input type="hidden" name="quantity" value="1">
            <button id="ProductSubmit-{{ section.id }}" type="submit" class="ws-cta"
                    {% unless v.available %}disabled{% endunless %}>
              {%- if v.available -%}
                {{ s.knop_label }} &mdash; {% render 'price-formated', price: v.price %}
              {%- else -%}
                {{ s.knop_uitverkocht }}
              {%- endif -%}
            </button>
            <p class="ws-melding" product-notification></p>
          {%- endform -%}

          {%- if v.available and s.voorraad_regel != blank -%}
            <div class="ws-vrd">
              <i></i>
              <span><b>{{ s.voorraad_kop }}</b> &middot; {{ mf.shipping_information.value | default: s.voorraad_regel }}</span>
            </div>
          {%- endif -%}
        </div>

        <div class="ws-pay">
          {% render 'payments' %}
          <span class="ws-vl"><svg><use href="#ws-pdp-slot-{{ section.id }}"/></svg>{{ s.veilig_label }}</span>
        </div>

        {%- comment -%} appblokken: Klarna, upsell-apps. Sleepbaar in de editor. {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          <div class="ws-apps">
            {%- for block in section.blocks -%}
              <div {{ block.shopify_attributes }}>{% render block %}</div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if s.vergelijk_label != blank -%}
          <a class="ws-cta2" href="{{ s.vergelijk_link | default: '#compare_table' }}">
            <svg><use href="#ws-pdp-vgl-{{ section.id }}"/></svg>{{ s.vergelijk_label }}
          </a>
        {%- endif -%}

        {%- if s.tel_waarde != blank -%}
          <p class="ws-tel">
            <svg><use href="#ws-pdp-mensen-{{ section.id }}"/></svg>
            <span>{{ s.tel_voor }} <b>{{ s.tel_waarde }}</b> {{ s.tel_na }}</span>
          </p>
        {%- endif -%}

        {%- comment -%} ---------- de vier accordeons ---------- {%- endcomment -%}
        <div class="ws-acc">
          <details>
            <summary>{{ s.acc1_titel }}<i></i></summary>
            <div class="in">
              {%- if product.description != blank -%}{{ product.description }}{%- endif -%}
              {%- if mf.specification != blank -%}{{ mf.specification }}{%- endif -%}
            </div>
          </details>

          {%- assign doos = mf.included_box.value -%}
          {%- if doos != blank -%}
            <details>
              <summary>{{ s.acc2_titel }}<i></i></summary>
              <div class="in">
                <dl class="ws-sp">
                  {%- for item in doos -%}
                    <dt>{{ item.title }}</dt>
                    <dd>{{ item.description }}</dd>
                  {%- endfor -%}
                </dl>
              </div>
            </details>
          {%- endif -%}

          {%- if s.acc3_tekst != blank -%}
            <details>
              <summary>{{ s.acc3_titel }}<i></i></summary>
              <div class="in">{{ s.acc3_tekst }}</div>
            </details>
          {%- endif -%}

          {%- if s.acc4_tekst != blank -%}
            <details>
              <summary>{{ s.acc4_titel }}<i></i></summary>
              <div class="in">{{ s.acc4_tekst }}</div>
            </details>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>


  <script>
    (function () {
      var wortel = document.getElementById('shopify-section-{{ section.id }}');
      if (!wortel) return;
      var baan = wortel.querySelector('#ws-baan-{{ section.id }}');
      var strook = wortel.querySelector('#ws-th-{{ section.id }}');
      if (!baan || !strook) return;

      function markeer(i) {
        var vakken = strook.querySelectorAll('figure');
        for (var n = 0; n < vakken.length; n++) {
          vakken[n].classList.toggle('ws-on', n === i);
        }
      }

      strook.addEventListener('click', function (e) {
        var knop = e.target.closest('[data-ws-dia]');
        if (!knop) return;
        var i = parseInt(knop.getAttribute('data-ws-dia'), 10);
        var dia = baan.children[i];
        if (!dia) return;
        baan.scrollTo({ left: dia.offsetLeft - baan.offsetLeft, behavior: 'smooth' });
        markeer(i);
      });

      var wacht;
      baan.addEventListener('scroll', function () {
        clearTimeout(wacht);
        wacht = setTimeout(function () {
          var breedte = baan.children[0] ? baan.children[0].offsetWidth : 1;
          markeer(Math.round(baan.scrollLeft / (breedte + 16)));
        }, 90);
      });
    })();
  </script>

  <script type="application/json" data-variants-data>{{ product.variants | json }}</script>
</main-product>

{% schema %}
{
  "name": "WS · PDP koopvak",
  "tag": "section",
  "class": "ws-pdp-sectie",
  "settings": [
    { "type": "paragraph", "content": "Titel, prijs, USP's, specificaties en doosinhoud komen uit het product. Alles hieronder is winkelbreed of een terugval." },
    { "type": "header", "content": "Podium" },
    { "type": "image_picker", "id": "merk", "label": "Monogram op de achtergrond" },
    { "type": "text", "id": "tag", "label": "Label linksboven", "default": "Meest gekozen" },
    { "type": "header", "content": "Campagne" },
    { "type": "text", "id": "campagne", "label": "Campagnelabel (terugval als custom.limited_offer leeg is)", "default": "Summer Sale" },
    { "type": "text", "id": "besparing_label", "label": "Kortingslabel — [korting] wordt het percentage", "default": "Bespaar [korting]%" },
    { "type": "text", "id": "besparing_regel", "label": "Regel bij het bespaarde bedrag", "default": "Je bespaart" },
    { "type": "header", "content": "Trustpilot" },
    { "type": "checkbox", "id": "tp_tonen", "label": "Beoordeling tonen", "default": true },
    { "type": "text", "id": "tp_label", "label": "Oordeel", "default": "Uitstekend" },
    { "type": "text", "id": "tp_score", "label": "Score en aantal", "default": "4,4 · 968 reviews" },
    { "type": "text", "id": "tp_bron", "label": "Bron bij het citaat", "default": "Trustpilot" },
    { "type": "text", "id": "koper_label", "label": "Label geverifieerde koper", "default": "Geverifieerde koper" },
    { "type": "header", "content": "Klantcitaat" },
    { "type": "paragraph", "content": "Wordt overschreven door custom.buybox_quote zodra dat veld bestaat. Laat leeg als er voor dit product geen echte productreview is." },
    { "type": "textarea", "id": "citaat", "label": "Citaat" },
    { "type": "text", "id": "citaat_wie", "label": "Naam en datum" },
    { "type": "header", "content": "Cadeau" },
    { "type": "text", "id": "gift_titel", "label": "Cadeauregel" },
    { "type": "text", "id": "gift_regel", "label": "Onderregel", "default": "Wordt vanzelf meegeleverd" },
    { "type": "header", "content": "Knop en levering" },
    { "type": "text", "id": "knop_label", "label": "Knoptekst", "default": "In winkelwagen" },
    { "type": "text", "id": "knop_uitverkocht", "label": "Knoptekst uitverkocht", "default": "Uitverkocht" },
    { "type": "text", "id": "voorraad_kop", "label": "Voorraadkop", "default": "Op voorraad" },
    { "type": "text", "id": "voorraad_regel", "label": "Leverregel (terugval)", "default": "vandaag vóór 23:59 besteld, morgen in huis" },
    { "type": "text", "id": "veilig_label", "label": "Label bij de betaalmerken", "default": "Veilig afrekenen" },
    { "type": "header", "content": "Vergelijken en teller" },
    { "type": "text", "id": "vergelijk_label", "label": "Knop vergelijken", "default": "Vergelijk de modellen" },
    { "type": "url", "id": "vergelijk_link", "label": "Link (leeg = #compare_table)" },
    { "type": "text", "id": "tel_voor", "label": "Teller — tekst ervoor", "default": "Al door" },
    { "type": "text", "id": "tel_waarde", "label": "Teller — getal", "default": "200.000+" },
    { "type": "text", "id": "tel_na", "label": "Teller — tekst erna", "default": "mannen gekozen" },
    { "type": "header", "content": "Accordeons" },
    { "type": "text", "id": "acc1_titel", "label": "1 — titel", "default": "Omschrijving & specificaties" },
    { "type": "text", "id": "acc2_titel", "label": "2 — titel", "default": "Wat zit er in de doos" },
    { "type": "text", "id": "acc3_titel", "label": "3 — titel", "default": "Verzending & retour" },
    { "type": "richtext", "id": "acc3_tekst", "label": "3 — tekst", "default": "<p>Vandaag vóór 23:59 besteld is morgen in huis. Gratis verzending binnen Nederland en België. Niet goed? Binnen 100 dagen terug, wij betalen de retour.</p>" },
    { "type": "text", "id": "acc4_titel", "label": "4 — titel", "default": "Garantie en proberen" },
    { "type": "richtext", "id": "acc4_tekst", "label": "4 — tekst", "default": "<p>Twee jaar garantie op elk apparaat. Honderd dagen proberen: bevalt het niet, dan krijg je je geld terug — ook als je hem gebruikt hebt.</p>" },
    { "type": "header", "content": "Indent settings" },
    { "type": "range", "id": "desk_indent_top", "label": "Indent top (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "desk_indent_bottom", "label": "Indent bottom (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mob_indent_top", "label": "Indent top (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "mob_indent_bottom", "label": "Indent bottom (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "WS · PDP koopvak" }]
}
{% endschema %}

{% stylesheet %}
  .ws-pdp .ws-apps{margin-top:13px}
  .ws-pdp .ws-apps:empty{display:none}
  .ws-pdp .ws-apps > div:empty{display:none}
  @media screen and (max-width:749px){
    .ws-pdp .ws-bb > .ws-apps{order:12}
    .ws-pdp .ws-bb > .ws-rev{order:13}
    .ws-pdp .ws-bb > .ws-cta2{order:14}
    .ws-pdp .ws-bb > .ws-tel{order:15}
    .ws-pdp .ws-bb > .ws-acc{order:16}
  }
{% endstylesheet %}
