{% comment %}
  Wellshave v7 · collabs: makers met Wellshave in beeld, als schuifrij met voortgangsbalk.
  Gewone foto's zonder link; onder elke foto de @handle met een blauw partnervinkje.
{% endcomment %}
{{ 'ws7.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ws7.js' | asset_url }}" defer></script>
<section class="ws7{% if section.settings.wit %} ws7-wit{% endif %}">
  <div class="ws7-binnen ws7-midden">
    {%- if section.settings.oog != blank -%}<p class="ws7-oog">{{ section.settings.oog }}</p>{%- endif -%}
    {% render 'ws7-kop', kop: section.settings.kop, goud: section.settings.kop_goud %}
    <div class="ws7-schuif">
      <div class="ws7-rij" tabindex="0" aria-label="Collabs, schuif opzij">
        {%- for block in section.blocks -%}
          <figure class="ws7-collab" {{ block.shopify_attributes }}>
            {%- if block.settings.foto != blank -%}
              {%- assign ws7_alt = '@' | append: block.settings.handle | append: ' met Wellshave' -%}
              {{ block.settings.foto | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(max-width: 749px) 44vw, 18vw', alt: ws7_alt }}
            {%- endif -%}
            <figcaption><b>@{{ block.settings.handle }}</b>
              {%- if block.settings.vinkje -%}<i class="ws7-vink" role="img" aria-label="Wellshave-partner" title="Wellshave-partner"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.6 8.3l2.2 2.2 4.6-4.8"/></svg></i>{%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
      {% render 'ws7-voortgang' %}
    </div>
    {%- if section.settings.link_label != blank -%}<a class="ws7-link ws7-collab-link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}{% render 'ws7-pijl' %}</a>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "WS7 · Collabs",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "oog", "label": "Bovenregel", "default": "Collabs" },
    { "type": "text", "id": "kop", "label": "Kop", "default": "Word deel van" },
    { "type": "text", "id": "kop_goud", "label": "Kop, regel in goud", "default": "de #wellshavefamilie." },
    { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Volg @wellshave" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "wit", "label": "Witte achtergrond", "default": false }
  ],
  "blocks": [
    { "type": "maker", "name": "Maker", "settings": [
      { "type": "image_picker", "id": "foto", "label": "Foto", "info": "Staand 4:5, met Wellshave in beeld en zonder tekst." },
      { "type": "text", "id": "handle", "label": "Instagram-naam zonder @", "default": "wellshave" },
      { "type": "checkbox", "id": "vinkje", "label": "Blauw partnervinkje", "default": true }
    ]}
  ],
  "presets": [ { "name": "WS7 · Collabs" } ]
}
{% endschema %}
